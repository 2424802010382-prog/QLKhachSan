@model QLKhachSan.Models.BookingDetailViewModel

@using System.Linq

@{
    Layout = null;

    var status =
        (Model.Status ?? "").Trim();

    var statusClass =
        "status-default";

    var statusIcon =
        "fa-circle-info";


    if (status == "Chờ xác nhận")
    {
        statusClass =
            "status-waiting";

        statusIcon =
            "fa-clock";
    }
    else if (status == "Đã xác nhận")
    {
        statusClass =
            "status-confirmed";

        statusIcon =
            "fa-circle-check";
    }
    else if (status == "Đã nhận phòng")
    {
        statusClass =
            "status-checkin";

        statusIcon =
            "fa-key";
    }
    else if (status == "Hoàn tất")
    {
        statusClass =
            "status-completed";

        statusIcon =
            "fa-circle-check";
    }
    else if (status == "Đã hủy")
    {
        statusClass =
            "status-cancelled";

        statusIcon =
            "fa-circle-xmark";
    }

    var canCancel =
    (
        status == "Chờ xác nhận" ||
        status == "Đã xác nhận"
    )

    &&
    Model.CheckInDate.Date >
        DateTime.Today
    &&
    Model.PaymentStatus !=
        "Đã thanh toán";
    var canRebook =
    status == "Đã hủy" ||
    status == "Hoàn tất";
    var nights =
(
Model.CheckOutDate.Date -
Model.CheckInDate.Date
).Days;


    if (nights < 1)
    {
        nights = 1;
    }
}

<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Chi tiết đặt phòng #@Model.BookingId - Luxury Hotel
    </title>


    <!-- TAILWIND -->
    <script src="https://cdn.tailwindcss.com"></script>


    <!-- FONT AWESOME -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />


    <style>

        body {
            font-family: Arial, "Segoe UI", sans-serif;
            background: linear-gradient( 180deg, #f7f4ed 0%, #ffffff 45%, #f4f4f4 100% );
        }


        .luxury-header {
            background: linear-gradient( 135deg, #090704 0%, #171006 55%, #2b1d08 100% );
        }


        .gold-text {
            color: #d4af37;
        }


        .gold-border {
            border-color: #d4af37;
        }


        .main-card {
            background: #ffffff;
            border: 1px solid #ece6d8;
            box-shadow: 0 15px 45px rgba(0, 0, 0, 0.08);
        }


        .room-image {
            width: 100%;
            height: 100%;
            min-height: 350px;
            object-fit: cover;
        }


        .section-card {
            background: #ffffff;
            border: 1px solid #ebe6dc;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
        }


        .info-box {
            background: #faf9f6;
            border: 1px solid #eee8db;
        }


        .status-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 8px 16px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 700;
        }


        .status-waiting {
            color: #92400e;
            background: #fef3c7;
            border: 1px solid #fde68a;
        }


        .status-confirmed {
            color: #1e40af;
            background: #dbeafe;
            border: 1px solid #bfdbfe;
        }


        .status-checkin {
            color: #075985;
            background: #e0f2fe;
            border: 1px solid #bae6fd;
        }


        .status-completed {
            color: #166534;
            background: #dcfce7;
            border: 1px solid #bbf7d0;
        }


        .status-cancelled {
            color: #991b1b;
            background: #fee2e2;
            border: 1px solid #fecaca;
        }


        .status-default {
            color: #374151;
            background: #f3f4f6;
            border: 1px solid #e5e7eb;
        }


        .gold-button {
            background: linear-gradient( 135deg, #b68a22, #e5c357 );
            color: #171006;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }


            .gold-button:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(180, 138, 34, 0.3);
            }


        .outline-button {
            border: 1px solid #d4af37;
            color: #8a6819;
            background: white;
            transition: all 0.2s ease;
        }


            .outline-button:hover {
                background: #d4af37;
                color: #111;
            }


        @@media (max-width: 768px) {

            .room-image {
                min-height: 230px;
                height: 230px;
            }
        }
    </style>

</head>


<body class="min-h-screen text-gray-800">


    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <header class="luxury-header
                   text-white">


        <div class="max-w-7xl
                    mx-auto
                    px-4
                    sm:px-6
                    lg:px-8
                    py-5">


            <div class="flex
                        flex-col
                        md:flex-row
                        md:items-center
                        md:justify-between
                        gap-4">


                <!-- LOGO -->

                <a href="@Url.Action(
                            "Index",
                            "Home"
                         )"
                   class="flex
                          items-center
                          gap-3">


                    <div class="w-11
                                h-11
                                rounded-full
                                border
                                border-yellow-500
                                flex
                                items-center
                                justify-center
                                text-yellow-400">

                        <i class="fas
                                  fa-crown
                                  text-xl">
                        </i>

                    </div>


                    <div>

                        <div class="font-bold
                                    text-xl
                                    tracking-wide">

                            LUXURY HOTEL

                        </div>


                        <div class="text-yellow-300
                                    text-xs
                                    tracking-[3px]">

                            LUXURY &amp; COMFORT

                        </div>

                    </div>

                </a>


                <!-- QUAY LẠI -->

                <a href="@Url.Action(
                            "Index",
                            "BookingHistory"
                         )"
                   class="border
                          border-yellow-500
                          text-yellow-300
                          hover:bg-yellow-500
                          hover:text-black
                          transition
                          rounded-lg
                          px-5
                          py-2.5
                          font-semibold
                          text-sm">

                    <i class="fas
                              fa-arrow-left
                              mr-2">
                    </i>

                    Quay lại lịch sử

                </a>

            </div>

        </div>


        <!-- TIÊU ĐỀ -->

        <div class="max-w-7xl
                    mx-auto
                    px-4
                    sm:px-6
                    lg:px-8
                    pt-8
                    pb-14
                    text-center">


            <p class="gold-text
                      text-sm
                      font-bold
                      tracking-[4px]
                      mb-3">

                THÔNG TIN KỲ NGHỈ

            </p>


            <h1 class="text-4xl
                       md:text-5xl
                       font-bold
                       mb-5"
                style="
                    font-family:
                    'Times New Roman',
                    Times,
                    serif;
                ">

                Chi Tiết Đặt Phòng
                #@Model.BookingId

            </h1>


            <span class="status-badge
                         @statusClass">

                <i class="fas
                          @statusIcon
                          mr-2">
                </i>

                @(string.IsNullOrWhiteSpace(status)
                    ? "Chưa cập nhật"
                    : status)

            </span>

        </div>

    </header>



    <!-- ========================================================= -->
    <!-- MAIN -->
    <!-- ========================================================= -->

    <main class="max-w-7xl
                 mx-auto
                 px-4
                 sm:px-6
                 lg:px-8
                 py-12">

        @if (TempData["BookingSuccess"] != null)
        {
            <div class="mb-8
                rounded-xl
                border border-green-200
                bg-green-50
                px-5 py-4
                text-green-700
                font-semibold">

                <i class="fas
                  fa-circle-check
                  mr-2">
                </i>

                @TempData["BookingSuccess"]

            </div>
        }


        @if (TempData["BookingError"] != null)
        {
            <div class="mb-8
                rounded-xl
                border border-red-200
                bg-red-50
                px-5 py-4
                text-red-700
                font-semibold">

                <i class="fas
                  fa-circle-exclamation
                  mr-2">
                </i>

                @TempData["BookingError"]

            </div>
        }
        <!-- ===================================================== -->
        <!-- THÔNG TIN PHÒNG -->
        <!-- ===================================================== -->

        <section class="main-card
                        rounded-2xl
                        overflow-hidden
                        mb-8">


            <div class="grid
                        grid-cols-1
                        lg:grid-cols-2">


                <!-- ẢNH -->

                <div class="relative">


                    @if (
                        !string.IsNullOrWhiteSpace(
                            Model.ImageUrl
                        )
                    )
                    {
                        <img src="@Model.ImageUrl"
                             alt="@Model.RoomName"
                             class="room-image" />
                    }
                    else
                    {
                        <div class="room-image
                                    bg-gray-200
                                    flex
                                    items-center
                                    justify-center
                                    text-gray-400">

                            <i class="fas
                                      fa-image
                                      text-6xl">
                            </i>

                        </div>
                    }


                    <div class="absolute
                                top-5
                                left-5
                                bg-black/75
                                text-white
                                rounded-lg
                                px-4
                                py-2
                                font-bold">

                        Mã đặt phòng
                        #@Model.BookingId

                    </div>

                </div>


                <!-- THÔNG TIN PHÒNG -->

                <div class="p-7
                            md:p-10">


                    <p class="text-yellow-700
                              uppercase
                              text-sm
                              font-bold
                              tracking-[3px]
                              mb-3">

                        @Model.RoomType

                    </p>


                    <h2 class="text-3xl
                               md:text-4xl
                               font-bold
                               text-gray-900
                               mb-7"
                        style="
                            font-family:
                            'Times New Roman',
                            Times,
                            serif;
                        ">

                        @Model.RoomName

                    </h2>


                    <div class="grid
                                grid-cols-1
                                sm:grid-cols-2
                                gap-4">


                        <div class="info-box
                                    rounded-xl
                                    p-4">

                            <p class="text-gray-500
                                      text-sm
                                      mb-1">

                                <i class="fas
                                          fa-door-open
                                          text-yellow-600
                                          mr-2">
                                </i>

                                Số phòng

                            </p>


                            <strong class="text-gray-900
                                           text-lg">

                                @Model.RoomCount phòng

                            </strong>

                        </div>


                        <div class="info-box
                                    rounded-xl
                                    p-4">

                            <p class="text-gray-500
                                      text-sm
                                      mb-1">

                                <i class="fas
                                          fa-users
                                          text-yellow-600
                                          mr-2">
                                </i>

                                Số khách

                            </p>


                            <strong class="text-gray-900
                                           text-lg">

                                @Model.GuestCount người

                            </strong>

                        </div>


                        <div class="info-box
                                    rounded-xl
                                    p-4
                                    sm:col-span-2">

                            <p class="text-gray-500
                                      text-sm
                                      mb-1">

                                <i class="fas
                                          fa-clock
                                          text-yellow-600
                                          mr-2">
                                </i>

                                Thời điểm đặt phòng

                            </p>


                            <strong class="text-gray-900">

                                @Model.CreatedAt.ToString(
                                    "dd/MM/yyyy HH:mm"
                                )

                            </strong>

                        </div>

                    </div>


                    <div class="mt-8">

                        <a href="@Url.Action(
                                    "Details",
                                    "Room",
                                    new
                                    {
                                        id = Model.RoomId
                                    }
                                 )"
                           class="outline-button
                                  inline-flex
                                  items-center
                                  justify-center
                                  rounded-xl
                                  px-6
                                  py-3
                                  font-bold">

                            <i class="fas
                                      fa-bed
                                      mr-2">
                            </i>

                            Xem thông tin phòng

                        </a>

                    </div>

                </div>

            </div>

        </section>



        <!-- ===================================================== -->
        <!-- THỜI GIAN LƯU TRÚ -->
        <!-- ===================================================== -->

        <section class="section-card
                        rounded-2xl
                        p-6
                        md:p-8
                        mb-8">


            <h2 class="text-2xl
                       font-bold
                       text-gray-900
                       mb-6">

                <i class="fas
                          fa-calendar-days
                          text-yellow-600
                          mr-2">
                </i>

                Thông tin lưu trú

            </h2>


            <div class="grid
                        grid-cols-1
                        md:grid-cols-3
                        gap-5">


                <div class="info-box
                            rounded-xl
                            p-5">

                    <p class="text-gray-500
                              text-sm
                              uppercase
                              tracking-wide
                              mb-2">

                        Ngày nhận phòng

                    </p>


                    <strong class="text-xl
                                   text-gray-900">

                        @Model.CheckInDate.ToString(
                            "dd/MM/yyyy"
                        )

                    </strong>

                </div>


                <div class="info-box
                            rounded-xl
                            p-5">

                    <p class="text-gray-500
                              text-sm
                              uppercase
                              tracking-wide
                              mb-2">

                        Ngày trả phòng

                    </p>


                    <strong class="text-xl
                                   text-gray-900">

                        @Model.CheckOutDate.ToString(
                            "dd/MM/yyyy"
                        )

                    </strong>

                </div>


                <div class="info-box
                            rounded-xl
                            p-5">

                    <p class="text-gray-500
                              text-sm
                              uppercase
                              tracking-wide
                              mb-2">

                        Thời gian lưu trú

                    </p>


                    <strong class="text-xl
                                   text-gray-900">

                        @nights đêm

                    </strong>

                </div>

            </div>


            @if (
                !string.IsNullOrWhiteSpace(
                    Model.SpecialRequest
                )
            )
            {
                <div class="mt-6
                            bg-blue-50
                            border
                            border-blue-100
                            rounded-xl
                            p-5">

                    <p class="font-bold
                              text-blue-800
                              mb-2">

                        <i class="fas
                                  fa-comment-dots
                                  mr-2">
                        </i>

                        Yêu cầu đặc biệt

                    </p>


                    <p class="text-blue-900">

                        @Model.SpecialRequest

                    </p>

                </div>
            }

        </section>



        <!-- ===================================================== -->
        <!-- KHÁCH HÀNG -->
        <!-- ===================================================== -->

        <section class="section-card
                        rounded-2xl
                        p-6
                        md:p-8
                        mb-8">


            <h2 class="text-2xl
                       font-bold
                       text-gray-900
                       mb-6">

                <i class="fas
                          fa-user
                          text-yellow-600
                          mr-2">
                </i>

                Thông tin khách hàng

            </h2>


            <div class="grid
                        grid-cols-1
                        md:grid-cols-2
                        gap-x-10
                        gap-y-6">


                <div>

                    <p class="text-sm
                              text-gray-500
                              mb-1">

                        Họ và tên

                    </p>

                    <p class="font-bold
                              text-gray-900">

                        @Model.CustomerName

                    </p>

                </div>


                <div>

                    <p class="text-sm
                              text-gray-500
                              mb-1">

                        Số điện thoại

                    </p>

                    <p class="font-bold
                              text-gray-900">

                        @Model.CustomerPhone

                    </p>

                </div>


                <div>

                    <p class="text-sm
                              text-gray-500
                              mb-1">

                        Email

                    </p>

                    <p class="font-bold
                              text-gray-900
                              break-all">

                        @Model.CustomerEmail

                    </p>

                </div>


                <div>

                    <p class="text-sm
                              text-gray-500
                              mb-1">

                        CCCD

                    </p>

                    <p class="font-bold
                              text-gray-900">

                        @(string.IsNullOrWhiteSpace(
                            Model.CustomerCCCD
                          )
                            ? "Không cung cấp"
                            : Model.CustomerCCCD)

                    </p>

                </div>

            </div>

        </section>



        <!-- ===================================================== -->
        <!-- DỊCH VỤ -->
        <!-- ===================================================== -->

        <section class="section-card
                        rounded-2xl
                        p-6
                        md:p-8
                        mb-8">


            <h2 class="text-2xl
                       font-bold
                       text-gray-900
                       mb-6">

                <i class="fas
                          fa-bell-concierge
                          text-yellow-600
                          mr-2">
                </i>

                Dịch vụ đã chọn

            </h2>


            @if (
                Model.Services == null ||
                !Model.Services.Any()
            )
            {
                <div class="bg-gray-50
                            rounded-xl
                            p-6
                            text-center
                            text-gray-500">

                    <i class="fas
                              fa-circle-info
                              mr-2">
                    </i>

                    Booking này không sử dụng
                    dịch vụ bổ sung.

                </div>
            }
            else
            {
                <div class="overflow-x-auto">

                    <table class="w-full
                                  min-w-[650px]">

                        <thead>

                            <tr class="border-b
                                       border-gray-200
                                       text-left
                                       text-gray-500
                                       text-sm">

                                <th class="py-3 pr-4">
                                    Dịch vụ
                                </th>

                                <th class="py-3 px-4
                                           text-center">
                                    Số lượng
                                </th>

                                <th class="py-3 px-4
                                           text-right">
                                    Đơn giá
                                </th>

                                <th class="py-3 pl-4
                                           text-right">
                                    Thành tiền
                                </th>

                            </tr>

                        </thead>


                        <tbody>


                            @foreach (
                                var service
                                in Model.Services
                            )
                            {
                                <tr class="border-b
                                           border-gray-100">

                                    <td class="py-4 pr-4">

                                        <p class="font-bold
                                                  text-gray-900">

                                            @service.ServiceName

                                        </p>


                                        @if (
                                            !string.IsNullOrWhiteSpace(
                                                service.Unit
                                            )
                                        )
                                        {
                                            <p class="text-xs
                                                      text-gray-400
                                                      mt-1">

                                                Đơn vị:
                                                @service.Unit

                                            </p>
                                        }

                                    </td>


                                    <td class="py-4 px-4
                                               text-center">

                                        @service.Quantity

                                    </td>


                                    <td class="py-4 px-4
                                               text-right">

                                        @service.UnitPrice.ToString(
                                            "N0"
                                        )đ

                                    </td>


                                    <td class="py-4 pl-4
                                               text-right
                                               font-bold
                                               text-gray-900">

                                        @service.TotalPrice.ToString(
                                            "N0"
                                        )đ

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </section>



        <!-- ===================================================== -->
        <!-- KHUYẾN MÃI -->
        <!-- ===================================================== -->

        <section class="section-card
                        rounded-2xl
                        p-6
                        md:p-8
                        mb-8">


            <h2 class="text-2xl
                       font-bold
                       text-gray-900
                       mb-6">

                <i class="fas
                          fa-tags
                          text-yellow-600
                          mr-2">
                </i>

                Khuyến mãi

            </h2>


            @if (
                Model.DiscountAmount > 0
            )
            {
                <div class="bg-green-50
                            border
                            border-green-200
                            rounded-xl
                            p-5">


                    <div class="flex
                                flex-col
                                md:flex-row
                                md:items-center
                                md:justify-between
                                gap-4">


                        <div>

                            <p class="text-sm
                                      text-green-700
                                      mb-1">

                                Mã khuyến mãi

                            </p>


                            <p class="font-extrabold
                                      text-xl
                                      text-green-800">

                                @(string.IsNullOrWhiteSpace(
                                    Model.PromotionCode
                                  )
                                    ? "Khuyến mãi"
                                    : Model.PromotionCode)

                            </p>


                            @if (
                                !string.IsNullOrWhiteSpace(
                                    Model.PromotionName
                                )
                            )
                            {
                                <p class="text-sm
                                          text-green-700
                                          mt-1">

                                    @Model.PromotionName

                                </p>
                            }

                        </div>


                        <div class="text-left
                                    md:text-right">

                            <p class="text-sm
                                      text-green-700">

                                Số tiền được giảm

                            </p>


                            <p class="text-2xl
                                      font-extrabold
                                      text-green-700">

                                -@Model.DiscountAmount.ToString(
                                 "N0"
                             )đ

                            </p>

                        </div>

                    </div>

                </div>
            }
            else
            {
                <div class="bg-gray-50
                            rounded-xl
                            p-5
                            text-gray-500">

                    Booking này không sử dụng
                    mã khuyến mãi.

                </div>
            }

        </section>



        <!-- ===================================================== -->
        <!-- THANH TOÁN + TỔNG TIỀN -->
        <!-- ===================================================== -->

        <section class="section-card
                        rounded-2xl
                        overflow-hidden
                        mb-8">


            <div class="grid
                        grid-cols-1
                        lg:grid-cols-2">


                <!-- THANH TOÁN -->

                <div class="p-6
                            md:p-8
                            border-b
                            lg:border-b-0
                            lg:border-r
                            border-gray-200">


                    <h2 class="text-2xl
                               font-bold
                               text-gray-900
                               mb-6">

                        <i class="fas
                                  fa-credit-card
                                  text-yellow-600
                                  mr-2">
                        </i>

                        Thanh toán

                    </h2>


                    <div class="space-y-5">


                        <div>

                            <p class="text-gray-500
                                      text-sm
                                      mb-1">

                                Phương thức thanh toán

                            </p>


                            <p class="font-bold
                                      text-gray-900">

                                @(string.IsNullOrWhiteSpace(
                                    Model.PaymentMethod
                                  )
                                    ? "Chưa cập nhật"
                                    : Model.PaymentMethod)

                            </p>

                        </div>


                        <div>

                            <p class="text-gray-500
                                      text-sm
                                      mb-1">

                                Trạng thái thanh toán

                            </p>


                            <p class="font-bold
                                      text-gray-900">

                                @(string.IsNullOrWhiteSpace(
                                    Model.PaymentStatus
                                  )
                                    ? "Chưa cập nhật"
                                    : Model.PaymentStatus)

                            </p>

                        </div>


                        @if (
                            Model.PaymentDate.HasValue
                        )
                        {
                            <div>

                                <p class="text-gray-500
                                          text-sm
                                          mb-1">

                                    Thời điểm tạo thanh toán

                                </p>


                                <p class="font-bold
                                          text-gray-900">

                                    @Model.PaymentDate.Value.ToString(
                                        "dd/MM/yyyy HH:mm"
                                    )

                                </p>

                            </div>
                        }


                        @if (
                            !string.IsNullOrWhiteSpace(
                                Model.TransactionCode
                            )
                        )
                        {
                            <div>

                                <p class="text-gray-500
                                          text-sm
                                          mb-1">

                                    Mã giao dịch

                                </p>


                                <p class="font-bold
                                          text-gray-900">

                                    @Model.TransactionCode

                                </p>

                            </div>
                        }

                    </div>

                </div>



                <!-- TỔNG TIỀN -->

                <div class="p-6
                            md:p-8
                            bg-[#faf8f3]">


                    <h2 class="text-2xl
                               font-bold
                               text-gray-900
                               mb-6">

                        <i class="fas
                                  fa-receipt
                                  text-yellow-600
                                  mr-2">
                        </i>

                        Chi tiết thanh toán

                    </h2>


                    <div class="space-y-4">


                        <div class="flex
                                    justify-between
                                    gap-4">

                            <span class="text-gray-600">

                                Tiền phòng

                            </span>


                            <strong>

                                @Model.RoomAmount.ToString(
                                    "N0"
                                )đ

                            </strong>

                        </div>


                        <div class="flex
                                    justify-between
                                    gap-4">

                            <span class="text-gray-600">

                                Dịch vụ

                            </span>


                            <strong>

                                @Model.ServiceAmount.ToString(
                                    "N0"
                                )đ

                            </strong>

                        </div>


                        <div class="flex
                                    justify-between
                                    gap-4
                                    text-green-700">

                            <span>

                                Giảm giá

                            </span>


                            <strong>

                                -@Model.DiscountAmount.ToString(
                                 "N0"
                             )đ

                            </strong>

                        </div>


                        <hr class="border-gray-300" />


                        <div class="flex
                                    justify-between
                                    items-end
                                    gap-4">


                            <span class="font-bold
                                         text-gray-900">

                                TỔNG THANH TOÁN

                            </span>


                            <span class="text-3xl
                                         font-extrabold
                                         text-yellow-700">

                                @Model.TotalAmount.ToString(
                                    "N0"
                                )đ

                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </section>



        <!-- ===================================================== -->
        <!-- NÚT CUỐI TRANG -->
        <!-- ===================================================== -->

        <div class="flex
                    flex-col
                    sm:flex-row
                    justify-center
                    gap-4">


            <a href="@Url.Action(
                        "Index",
                        "BookingHistory"
                     )"
               class="outline-button
                      px-7
                      py-3.5
                      rounded-xl
                      font-bold
                      text-center">

                <i class="fas
                          fa-arrow-left
                          mr-2">
                </i>

                Quay lại lịch sử

            </a>

            @if (canCancel)
            {
                <form action="@Url.Action(
                      "Cancel",
                      "BookingHistory"
                  )"
                      method="post"
                      onsubmit="
              return confirm(
                  'Bạn có chắc chắn muốn hủy đặt phòng #@Model.BookingId không?'
              );
          ">

                    @Html.AntiForgeryToken()


                    <input type="hidden"
                           name="id"
                           value="@Model.BookingId" />


                    <button type="submit"
                            class="w-full
                       sm:w-auto
                       bg-red-600
                       hover:bg-red-700
                       text-white
                       px-7
                       py-3.5
                       rounded-xl
                       font-bold
                       transition">

                        <i class="fas
                      fa-ban
                      mr-2">
                        </i>

                        Hủy đặt phòng

                    </button>

                </form>
            }
            @if (canRebook)
            {
                <a href="@Url.Action(
                "Index",
                "Home",
                new
                {
                    rebookRoomId =
                        Model.RoomId
                }
             )"
                   class="inline-flex
              items-center
              justify-center
              bg-green-600
              hover:bg-green-700
              text-white
              px-7
              py-3.5
              rounded-xl
              font-bold
              transition
              text-center">

                    <i class="fas
                  fa-rotate-right
                  mr-2">
                    </i>

                    Đặt lại phòng này

                </a>
            }

            <a href="@Url.Action(
                        "Details",
                        "Room",
                        new
                        {
                            id = Model.RoomId
                        }
                     )"
               class="gold-button
                      px-7
                      py-3.5
                      rounded-xl
                      font-bold
                      text-center">

                <i class="fas
                          fa-bed
                          mr-2">
                </i>

                Xem phòng

            </a>

        </div>
        @if (
    !canCancel &&
    status != "Đã hủy" &&
    (
        status == "Chờ xác nhận" ||
        status == "Đã xác nhận"
    )
)
        {
            <div class="mt-5
                text-center
                text-sm
                text-gray-500">

                @if (
                    Model.PaymentStatus ==
                    "Đã thanh toán"
                )
                {
                    <span>

                        <i class="fas
                          fa-circle-info
                          mr-1">
                        </i>

                        Booking đã thanh toán.
                        Vui lòng liên hệ khách sạn
                        nếu cần hủy và hoàn tiền.

                    </span>
                }
                else if (
                    Model.CheckInDate.Date <=
                    DateTime.Today
                )
                {
                    <span>

                        <i class="fas
                          fa-circle-info
                          mr-1">
                        </i>

                        Booking đã tới ngày nhận phòng
                        nên không thể hủy trực tuyến.

                    </span>
                }

            </div>
        }


    </main>



    <!-- ========================================================= -->
    <!-- FOOTER -->
    <!-- ========================================================= -->

    <footer class="mt-12
                   bg-[#0d0a05]
                   text-gray-400
                   py-8">

        <div class="max-w-7xl
                    mx-auto
                    px-4
                    text-center
                    text-sm">

            <i class="fas
                      fa-crown
                      text-yellow-500
                      mr-2">
            </i>

            Luxury Hotel

            <span class="mx-2">
                •
            </span>

            Chi tiết đặt phòng
            #@Model.BookingId

        </div>

    </footer>


</body>

</html>