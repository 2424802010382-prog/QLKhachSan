@model IEnumerable<QLKhachSan.Models.Booking>
@{
    var todayRevenue =
        ViewBag.TodayRevenue != null
        ? Convert.ToDecimal(ViewBag.TodayRevenue)
        : 0;

    var monthRevenue =
        ViewBag.MonthRevenue != null
        ? Convert.ToDecimal(ViewBag.MonthRevenue)
        : 0;
}

@{
    ViewBag.Title = "Quản lý đặt phòng";
}

<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Quản lý đặt phòng</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

</head>

<body class="bg-gray-100">

    <div class="min-h-screen">

        <!-- HEADER -->

        <div class="bg-gray-900 text-white py-6">

            <div class="container mx-auto px-5">

                <div class="flex justify-between items-center">

                    <div>

                        <h1 class="text-3xl font-bold">

                            <i class="fas fa-hotel text-yellow-400 mr-2"></i>

                            QUẢN LÝ KHÁCH SẠN

                        </h1>

                        <p class="text-gray-400 mt-1">
                            Quản lý đơn đặt phòng
                        </p>

                    </div>

                    <div class="flex gap-3">

                        <a href="@Url.Action("Index", "Home")"
                           class="bg-yellow-500 text-gray-900 px-5 py-3 rounded-lg font-bold">

                            <i class="fas fa-home mr-2"></i>
                            Trang chủ

                        </a>

                        <a href="@Url.Action("Logout", "Account")"
                           class="bg-red-600 hover:bg-red-700 text-white px-5 py-3 rounded-lg font-bold">

                            <i class="fas fa-sign-out-alt mr-2"></i>
                            Đăng xuất

                        </a>

                    </div>

                </div>

            </div>

        </div>


        <!-- CONTENT -->

        <div class="container mx-auto px-5 py-10">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">

                <!-- TỔNG ĐƠN -->
                <div class="bg-white rounded-xl shadow-lg p-6">

                    <div class="flex items-center justify-between">

                        <div>
                            <p class="text-gray-500 font-semibold">
                                Tổng đơn đặt phòng
                            </p>

                            <h2 class="text-4xl font-bold mt-2 text-gray-800">
                                @ViewBag.TotalBookings
                            </h2>
                        </div>

                        <div class="bg-blue-100 text-blue-600
                        w-14 h-14 rounded-full
                        flex items-center justify-center">

                            <i class="fas fa-calendar-check text-2xl"></i>

                        </div>

                    </div>

                </div>


                <!-- CHỜ XÁC NHẬN -->
                <div class="bg-white rounded-xl shadow-lg p-6">

                    <div class="flex items-center justify-between">

                        <div>
                            <p class="text-gray-500 font-semibold">
                                Chờ xác nhận
                            </p>

                            <h2 class="text-4xl font-bold mt-2 text-yellow-600">
                                @ViewBag.PendingBookings
                            </h2>
                        </div>

                        <div class="bg-yellow-100 text-yellow-600
                        w-14 h-14 rounded-full
                        flex items-center justify-center">

                            <i class="fas fa-clock text-2xl"></i>

                        </div>

                    </div>

                </div>


                <!-- DOANH THU HÔM NAY -->
                <div class="bg-white rounded-xl shadow-lg p-6">

                    <div class="flex items-center justify-between">

                        <div>
                            <p class="text-gray-500 font-semibold">
                                Doanh thu hôm nay
                            </p>

                            <h2 class="text-2xl font-bold mt-2 text-green-600">
                                @todayRevenue.ToString("N0")đ
                            </h2>
                        </div>

                        <div class="bg-green-100 text-green-600
                        w-14 h-14 rounded-full
                        flex items-center justify-center">

                            <i class="fas fa-money-bill-wave text-2xl"></i>

                        </div>

                    </div>

                </div>


                <!-- DOANH THU THÁNG -->
                <div class="bg-white rounded-xl shadow-lg p-6">

                    <div class="flex items-center justify-between">

                        <div>
                            <p class="text-gray-500 font-semibold">
                                Doanh thu tháng này
                            </p>

                            <h2 class="text-2xl font-bold mt-2 text-purple-600">
                                @monthRevenue.ToString("N0")đ
                            </h2>
                        </div>

                        <div class="bg-purple-100 text-purple-600
                        w-14 h-14 rounded-full
                        flex items-center justify-center">

                            <i class="fas fa-chart-line text-2xl"></i>

                        </div>

                    </div>

                </div>

            </div>
            <!-- ========================================================= -->
            <!-- QUẢN LÝ NHÀ HÀNG -->
            <!-- ========================================================= -->

            <div style="
    background:white;
    border-radius:16px;
    padding:24px;
    margin-bottom:24px;
    box-shadow:0 4px 16px rgba(0,0,0,.08);
">

                <!-- TIÊU ĐỀ -->

                <div style="
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:16px;
        margin-bottom:20px;
        flex-wrap:wrap;
    ">

                    <div>

                        <h2 style="
                margin:0;
                font-size:22px;
                font-weight:800;
                color:#111827;
            ">

                            🍽️ Quản lý nhà hàng

                        </h2>

                        <p style="
                margin:6px 0 0 0;
                color:#6b7280;
                font-size:14px;
            ">

                            Quản lý thực đơn và xử lý các đơn gọi món của khách.

                        </p>

                    </div>


                    <a href="@Url.Action(
                    "Index",
                    "Restaurant"
                 )"
                       style="
               text-decoration:none;
               color:#a16207;
               font-weight:700;
           ">

                        Xem nhà hàng →

                    </a>

                </div>



                <!-- 2 CHỨC NĂNG -->

                <div style="
        display:grid;
        grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
        gap:18px;
    ">


                    <!-- QUẢN LÝ ĐƠN MÓN -->

                    <a href="@Url.Action(
                    "AdminOrders",
                    "Restaurant"
                 )"
                       style="
               text-decoration:none;
               color:inherit;
               border:1px solid #fde68a;
               background:#fffbeb;
               border-radius:14px;
               padding:20px;
               display:flex;
               align-items:center;
               gap:16px;
               transition:.2s;
           ">

                        <div style="
                width:56px;
                height:56px;
                flex-shrink:0;
                border-radius:14px;
                background:#fbbf24;
                display:flex;
                align-items:center;
                justify-content:center;
                color:#111827;
                font-size:24px;
            ">

                            <i class="fas fa-receipt"></i>

                        </div>


                        <div>

                            <div style="
                    font-size:17px;
                    font-weight:800;
                    color:#111827;
                    margin-bottom:5px;
                ">

                                Quản lý đơn gọi món

                            </div>

                            <div style="
                    font-size:13px;
                    color:#6b7280;
                    line-height:1.5;
                ">

                                Xác nhận đơn, chuẩn bị món,
                                giao món và cập nhật thanh toán.

                            </div>

                        </div>

                    </a>



                    <!-- QUẢN LÝ THỰC ĐƠN -->

                    <a href="@Url.Action(
                    "ManageFoods",
                    "Restaurant"
                 )"
                       style="
               text-decoration:none;
               color:inherit;
               border:1px solid #bbf7d0;
               background:#f0fdf4;
               border-radius:14px;
               padding:20px;
               display:flex;
               align-items:center;
               gap:16px;
               transition:.2s;
           ">

                        <div style="
                width:56px;
                height:56px;
                flex-shrink:0;
                border-radius:14px;
                background:#22c55e;
                display:flex;
                align-items:center;
                justify-content:center;
                color:white;
                font-size:24px;
            ">

                            <i class="fas fa-utensils"></i>

                        </div>


                        <div>

                            <div style="
                    font-size:17px;
                    font-weight:800;
                    color:#111827;
                    margin-bottom:5px;
                ">

                                Quản lý thực đơn

                            </div>

                            <div style="
                    font-size:13px;
                    color:#6b7280;
                    line-height:1.5;
                ">

                                Xem món ăn, giá bán,
                                món nổi bật và bật / ngừng bán.

                            </div>

                        </div>

                    </a>

                </div>

            </div>
            <div class="bg-white rounded-xl shadow-lg p-6 mb-8">

                <div class="flex justify-between items-center mb-6">

                    <div>
                        <h2 class="text-2xl font-bold text-gray-800">
                            Doanh thu 7 ngày gần nhất
                        </h2>

                        <p class="text-gray-500 mt-1">
                            Chỉ tính các đơn đã xác nhận
                        </p>
                    </div>

                    <div class="bg-green-100 text-green-600
                    w-12 h-12 rounded-full
                    flex items-center justify-center">

                        <i class="fas fa-chart-line text-xl"></i>

                    </div>

                </div>

                <div style="height: 350px;">
                    <canvas id="revenueChart"></canvas>
                </div>

            </div>
            <div class="bg-white rounded-xl shadow-lg p-6 mb-8">

                <h2 class="text-xl font-bold text-gray-800 mb-5">

                    <i class="fas fa-filter text-yellow-600 mr-2"></i>

                    Tìm kiếm và lọc đơn

                </h2>


                <form method="get"
                      action="@Url.Action("Index", "Admin")">

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">


                        <!-- TÌM KHÁCH -->

                        <div>

                            <label class="block font-semibold text-gray-700 mb-2">
                                Tìm khách hàng
                            </label>

                            <input type="text"
                                   name="keyword"
                                   value="@ViewBag.Keyword"
                                   placeholder="Tên, SĐT hoặc email..."
                                   class="w-full border rounded-lg px-4 py-3" />

                        </div>


                        <!-- TRẠNG THÁI -->

                        <div>

                            <label class="block font-semibold text-gray-700 mb-2">
                                Trạng thái
                            </label>

                            <select name="status"
                                    class="w-full border rounded-lg px-4 py-3">

                                <option value="">
                                    -- Tất cả --
                                </option>

                                <option value="Chờ xác nhận"
                                        @(ViewBag.Status == "Chờ xác nhận" ? "selected" : "")>
                                    Chờ xác nhận
                                </option>

                                <option value="Đã xác nhận"
                                        @(ViewBag.Status == "Đã xác nhận" ? "selected" : "")>
                                    Đã xác nhận
                                </option>

                                <option value="Đã hủy"
                                        @(ViewBag.Status == "Đã hủy" ? "selected" : "")>
                                    Đã hủy
                                </option>

                            </select>

                        </div>


                        <!-- TỪ NGÀY -->

                        <div>

                            <label class="block font-semibold text-gray-700 mb-2">
                                Từ ngày
                            </label>

                            <input type="date"
                                   name="fromDate"
                                   value="@ViewBag.FromDate"
                                   class="w-full border rounded-lg px-4 py-3" />

                        </div>


                        <!-- ĐẾN NGÀY -->

                        <div>

                            <label class="block font-semibold text-gray-700 mb-2">
                                Đến ngày
                            </label>

                            <input type="date"
                                   name="toDate"
                                   value="@ViewBag.ToDate"
                                   class="w-full border rounded-lg px-4 py-3" />

                        </div>

                    </div>


                    <div class="flex gap-3 mt-6">

                        <button type="submit"
                                class="bg-yellow-500 hover:bg-yellow-600
                           text-gray-900 font-bold
                           px-6 py-3 rounded-lg">

                            <i class="fas fa-search mr-2"></i>

                            Tìm kiếm

                        </button>


                        <a href="@Url.Action("Index", "Admin")"
                           class="bg-gray-500 hover:bg-gray-600
                      text-white font-bold
                      px-6 py-3 rounded-lg">

                            <i class="fas fa-redo mr-2"></i>

                            Xóa bộ lọc

                        </a>

                    </div>

                </form>

            </div>
            <div class="bg-white rounded-xl shadow-lg overflow-hidden">

                <div class="p-6 border-b">

                    <h2 class="text-2xl font-bold text-gray-800">

                        <i class="fas fa-calendar-check text-yellow-600 mr-2"></i>

                        Danh sách đơn đặt phòng

                    </h2>

                </div>


                <div class="overflow-x-auto">

                    <table class="w-full">

                        <thead class="bg-gray-800 text-white">

                            <tr>

                                <th class="p-4 text-left">
                                    Mã
                                </th>

                                <th class="p-4 text-left">
                                    Khách hàng
                                </th>

                                <th class="p-4 text-left">
                                    Phòng
                                </th>

                                <th class="p-4 text-left">
                                    Nhận phòng
                                </th>

                                <th class="p-4 text-left">
                                    Trả phòng
                                </th>

                                <th class="p-4 text-center">
                                    Số phòng
                                </th>

                                <th class="p-4 text-right">
                                    Tổng tiền
                                </th>

                                <th class="p-4 text-center">
                                    Trạng thái
                                </th>

                                <th class="p-4 text-center">
                                    Thao tác
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var booking in Model)
                            {
                                <tr class="border-b hover:bg-gray-50">

                                    <td class="p-4 font-bold">

                                        #@booking.BookingId

                                    </td>


                                    <td class="p-4">

                                        <p class="font-semibold">

                                            @booking.CustomerName

                                        </p>

                                        <p class="text-sm text-gray-500">

                                            @booking.CustomerPhone

                                        </p>

                                        <p class="text-sm text-gray-500">

                                            @booking.CustomerEmail

                                        </p>

                                    </td>


                                    <td class="p-4">

                                        @if (booking.Room != null)
                                        {
                                            <span class="font-semibold">

                                                @booking.Room.RoomName

                                            </span>
                                        }

                                    </td>


                                    <td class="p-4">

                                        @booking.CheckInDate.ToString("dd/MM/yyyy")

                                    </td>


                                    <td class="p-4">

                                        @booking.CheckOutDate.ToString("dd/MM/yyyy")

                                    </td>


                                    <td class="p-4 text-center">

                                        @booking.RoomCount

                                    </td>


                                    <td class="p-4 text-right font-bold text-yellow-700">

                                        @booking.TotalAmount.ToString("N0")đ

                                    </td>


                                    <td class="p-4 text-center">

                                        @if (booking.Status == "Chờ xác nhận")
                                        {
                                            <span class="bg-yellow-100 text-yellow-700 px-3 py-1 rounded-full text-sm font-bold">

                                                Chờ xác nhận

                                            </span>
                                        }
                                        else if (booking.Status == "Đã xác nhận")
                                        {
                                            <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm font-bold">

                                                Đã xác nhận

                                            </span>
                                        }
                                        else if (booking.Status == "Đã hủy")
                                        {
                                            <span class="bg-red-100 text-red-700 px-3 py-1 rounded-full text-sm font-bold">

                                                Đã hủy

                                            </span>
                                        }

                                    </td>


                                    <td class="p-4">

                                        @if (booking.Status == "Chờ xác nhận")
                                        {
                                            <div class="flex gap-2 justify-center">

                                                @using (Html.BeginForm(
                                                    "Confirm",
                                                    "Admin",
                                                    new { id = booking.BookingId },
                                                    FormMethod.Post,
                                                    null))
                                                {
                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="bg-green-600 hover:bg-green-700 text-white px-3 py-2 rounded-lg text-sm">

                                                        <i class="fas fa-check mr-1"></i>

                                                        Xác nhận

                                                    </button>
                                                }


                                                @using (Html.BeginForm(
                                                    "Cancel",
                                                    "Admin",
                                                    new { id = booking.BookingId },
                                                    FormMethod.Post,
                                                    null))
                                                {
                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            onclick="return confirm('Bạn có chắc muốn hủy đơn này?')"
                                                            class="bg-red-600 hover:bg-red-700 text-white px-3 py-2 rounded-lg text-sm">

                                                        <i class="fas fa-times mr-1"></i>

                                                        Hủy

                                                    </button>
                                                }

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-gray-400 text-sm">

                                                Đã xử lý

                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>
    <script>

        const revenueLabels =
            @Html.Raw(
                Newtonsoft.Json.JsonConvert.SerializeObject(
                    ViewBag.RevenueLabels
                )
            );

        const revenueData =
            @Html.Raw(
                Newtonsoft.Json.JsonConvert.SerializeObject(
                    ViewBag.RevenueData
                )
            );


        const ctx =
            document
                .getElementById('revenueChart')
                .getContext('2d');


        new Chart(ctx, {

            type: 'bar',

            data: {

                labels: revenueLabels,

                datasets: [
                    {
                        label: 'Doanh thu',

                        data: revenueData,

                        borderWidth: 1,

                        borderRadius: 8
                    }
                ]
            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                plugins: {

                    legend: {
                        display: false
                    },

                    tooltip: {

                        callbacks: {

                            label: function (context) {

                                return Number(
                                    context.raw
                                ).toLocaleString('vi-VN')
                                    + 'đ';
                            }
                        }
                    }
                },

                scales: {

                    y: {

                        beginAtZero: true,

                        ticks: {

                            callback: function (value) {

                                return Number(value)
                                    .toLocaleString('vi-VN')
                                    + 'đ';
                            }
                        }
                    }
                }
            }
        });

    </script>

</body>

</html>