@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8" />

    <title>Đăng nhập Admin</title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="bg-gray-900 min-h-screen flex items-center justify-center">

    <div class="bg-white w-full max-w-md rounded-2xl shadow-2xl p-8">

        <h1 class="text-3xl font-bold text-center mb-2">
            LUXURY HOTEL
        </h1>

        <p class="text-center text-gray-500 mb-8">
            Đăng nhập hệ thống quản trị
        </p>


        @if (ViewBag.Error != null)
        {
            <div class="bg-red-100 text-red-700 p-3 rounded-lg mb-5">

                @ViewBag.Error

            </div>
        }


        @using (Html.BeginForm(
            "Login",
            "Account",
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()


            <div class="mb-5">

                <label class="font-semibold">
                    Tên đăng nhập
                </label>

                <input type="text"
                       name="username"
                       required
                       class="w-full mt-2 px-4 py-3 border rounded-lg"
                       placeholder="Nhập tên đăng nhập" />

            </div>


            <div class="mb-6">

                <label class="font-semibold">
                    Mật khẩu
                </label>

                <input type="password"
                       name="password"
                       required
                       class="w-full mt-2 px-4 py-3 border rounded-lg"
                       placeholder="Nhập mật khẩu" />

            </div>


            <button type="submit"
                    class="w-full bg-yellow-500 hover:bg-yellow-600 py-3 rounded-lg font-bold">

                Đăng nhập

            </button>
        }

    </div>

</body>

</html>