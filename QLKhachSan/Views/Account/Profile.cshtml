@model QLKhachSan.Models.AccountProfileViewModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Tài khoản của tôi - Luxury Hotel
    </title>


    <!-- TAILWIND -->
    <script src="https://cdn.tailwindcss.com"></script>


    <!-- FONT AWESOME -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />


    <style>

        body {
            margin: 0;
            font-family: Arial, "Segoe UI", sans-serif;
            background: linear-gradient( 180deg, #f8f5ed 0%, #ffffff 45%, #f4f4f4 100% );
        }


        .luxury-header {
            background: linear-gradient( 135deg, #090704 0%, #171006 55%, #2b1d08 100% );
        }


        .profile-card {
            background: #ffffff;
            border: 1px solid #ece6d8;
            box-shadow: 0 15px 45px rgba(0, 0, 0, 0.08);
        }


        .gold-button {
            background: linear-gradient( 135deg, #b68a22, #e5c357 );
            color: #171006;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }


            .gold-button:hover {
                transform: translateY(-1px);
                box-shadow: 0 8px 24px rgba(180, 138, 34, 0.25);
            }


        .input-box:focus {
            border-color: #d4af37;
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15);
            outline: none;
        }
    </style>

</head>


<body class="min-h-screen
             text-gray-800">


    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <header class="luxury-header
                   text-white">


        <div class="max-w-6xl
                    mx-auto
                    px-4
                    sm:px-6
                    lg:px-8
                    py-5">


            <div class="flex
                        flex-col
                        sm:flex-row
                        sm:items-center
                        sm:justify-between
                        gap-4">


                <!-- LOGO -->

                <a href="@Url.Action(
                            "Index",
                            "Home"
                         )"
                   class="flex
                          items-center
                          gap-3">


                    <div class="w-11
                                h-11
                                rounded-full
                                border
                                border-yellow-500
                                flex
                                items-center
                                justify-center
                                text-yellow-400">

                        <i class="fas
                                  fa-crown">
                        </i>

                    </div>


                    <div>

                        <div class="font-bold
                                    text-xl">

                            LUXURY HOTEL

                        </div>


                        <div class="text-yellow-300
                                    text-xs
                                    tracking-[3px]">

                            LUXURY &amp; COMFORT

                        </div>

                    </div>

                </a>


                <!-- QUAY VỀ TRANG CHỦ -->

                <a href="@Url.Action(
                            "Index",
                            "Home"
                         )"
                   class="border
                          border-yellow-500
                          text-yellow-300
                          hover:bg-yellow-500
                          hover:text-black
                          transition
                          rounded-lg
                          px-5
                          py-2.5
                          font-semibold
                          text-sm">

                    <i class="fas
                              fa-house
                              mr-2">
                    </i>

                    Trang chủ

                </a>

            </div>

        </div>



        <!-- TIÊU ĐỀ -->

        <div class="max-w-6xl
                    mx-auto
                    px-4
                    pt-8
                    pb-14
                    text-center">


            <p class="text-yellow-400
                      text-sm
                      font-bold
                      tracking-[4px]
                      mb-3">

                THÔNG TIN THÀNH VIÊN

            </p>


            <h1 class="text-4xl
                       md:text-5xl
                       font-bold">

                Tài Khoản Của Tôi

            </h1>

        </div>

    </header>



    <!-- ========================================================= -->
    <!-- MAIN -->
    <!-- ========================================================= -->

    <main class="max-w-3xl
                 mx-auto
                 px-4
                 sm:px-6
                 py-12">


        <!-- ===================================================== -->
        <!-- THÔNG BÁO CẬP NHẬT PROFILE -->
        <!-- ===================================================== -->

        @if (TempData["ProfileSuccess"] != null)
        {
            <div class="mb-6
                        rounded-xl
                        border
                        border-green-200
                        bg-green-50
                        px-5
                        py-4
                        text-green-700
                        font-semibold">

                <i class="fas
                          fa-circle-check
                          mr-2">
                </i>

                @TempData["ProfileSuccess"]

            </div>
        }


        @if (TempData["ProfileError"] != null)
        {
            <div class="mb-6
                        rounded-xl
                        border
                        border-red-200
                        bg-red-50
                        px-5
                        py-4
                        text-red-700
                        font-semibold">

                <i class="fas
                          fa-circle-exclamation
                          mr-2">
                </i>

                @TempData["ProfileError"]

            </div>
        }



        <!-- ===================================================== -->
        <!-- THÔNG BÁO ĐỔI MẬT KHẨU -->
        <!-- ===================================================== -->

        @if (TempData["PasswordSuccess"] != null)
        {
            <div class="mb-6
                        rounded-xl
                        border
                        border-green-200
                        bg-green-50
                        px-5
                        py-4
                        text-green-700
                        font-semibold">

                <i class="fas
                          fa-circle-check
                          mr-2">
                </i>

                @TempData["PasswordSuccess"]

            </div>
        }


        @if (TempData["PasswordError"] != null)
        {
            <div class="mb-6
                        rounded-xl
                        border
                        border-red-200
                        bg-red-50
                        px-5
                        py-4
                        text-red-700
                        font-semibold">

                <i class="fas
                          fa-circle-exclamation
                          mr-2">
                </i>

                @TempData["PasswordError"]

            </div>
        }



        <!-- ===================================================== -->
        <!-- CARD TÀI KHOẢN -->
        <!-- ===================================================== -->

        <section class="profile-card
                        rounded-2xl
                        overflow-hidden">


            <!-- PHẦN GIỚI THIỆU -->

            <div class="bg-[#faf7ef]
                        border-b
                        border-yellow-100
                        p-7
                        text-center">


                <div class="w-24
                            h-24
                            rounded-full
                            mx-auto
                            bg-yellow-100
                            border-4
                            border-white
                            shadow
                            flex
                            items-center
                            justify-center
                            text-yellow-700
                            text-5xl
                            mb-4">

                    <i class="fas
                              fa-user-circle">
                    </i>

                </div>


                <h2 class="text-2xl
                           font-bold
                           text-gray-900">

                    @Model.FullName

                </h2>


                <p class="text-gray-500
                          mt-1">

                    @Model.Email

                </p>

            </div>



            <!-- ================================================= -->
            <!-- THÔNG TIN CÁ NHÂN -->
            <!-- ================================================= -->

            <div class="p-7
                        md:p-9">


                <div class="mb-7">

                    <h3 class="text-2xl
                               font-bold
                               text-gray-900">

                        <i class="fas
                                  fa-user-pen
                                  text-yellow-600
                                  mr-2">
                        </i>

                        Thông tin cá nhân

                    </h3>


                    <p class="text-gray-500
                              text-sm
                              mt-2">

                        Bạn có thể cập nhật họ tên
                        và địa chỉ email của mình.

                    </p>

                </div>



                <!-- ============================================= -->
                <!-- FORM PROFILE -->
                <!-- ============================================= -->

                <form action="@Url.Action(
                                  "Profile",
                                  "Account"
                              )"
                      method="post">

                    @Html.AntiForgeryToken()


                    <!-- ========================================= -->
                    <!-- USERNAME -->
                    <!-- ========================================= -->

                    <div class="mb-6">

                        <label class="block
                                      font-semibold
                                      text-gray-700
                                      mb-2">

                            Tên đăng nhập

                        </label>


                        <div class="relative">

                            <i class="fas
                                      fa-user
                                      absolute
                                      left-4
                                      top-1/2
                                      -translate-y-1/2
                                      text-gray-400">
                            </i>


                            <input type="text"
                                   value="@Model.Username"
                                   readonly
                                   class="w-full
                                          bg-gray-100
                                          border
                                          border-gray-300
                                          rounded-xl
                                          pl-11
                                          pr-4
                                          py-3
                                          text-gray-500
                                          cursor-not-allowed" />

                        </div>


                        <p class="text-xs
                                  text-gray-400
                                  mt-2">

                            Tên đăng nhập được quản lý
                            tự động bởi hệ thống.

                        </p>

                    </div>



                    <!-- ========================================= -->
                    <!-- HỌ TÊN -->
                    <!-- ========================================= -->

                    <div class="mb-6">

                        <label class="block
                                      font-semibold
                                      text-gray-700
                                      mb-2">

                            Họ và tên

                            <span class="text-red-500">
                                *
                            </span>

                        </label>


                        <div class="relative">

                            <i class="fas
                                      fa-id-card
                                      absolute
                                      left-4
                                      top-1/2
                                      -translate-y-1/2
                                      text-gray-400">
                            </i>


                            <input type="text"
                                   name="FullName"
                                   value="@Model.FullName"
                                   required
                                   maxlength="100"
                                   autocomplete="name"
                                   class="input-box
                                          w-full
                                          border
                                          border-gray-300
                                          rounded-xl
                                          pl-11
                                          pr-4
                                          py-3
                                          transition" />

                        </div>

                    </div>



                    <!-- ========================================= -->
                    <!-- EMAIL -->
                    <!-- ========================================= -->

                    <div class="mb-8">

                        <label class="block
                                      font-semibold
                                      text-gray-700
                                      mb-2">

                            Email

                            <span class="text-red-500">
                                *
                            </span>

                        </label>


                        <div class="relative">

                            <i class="fas
                                      fa-envelope
                                      absolute
                                      left-4
                                      top-1/2
                                      -translate-y-1/2
                                      text-gray-400">
                            </i>


                            <input type="email"
                                   name="Email"
                                   value="@Model.Email"
                                   required
                                   autocomplete="email"
                                   class="input-box
                                          w-full
                                          border
                                          border-gray-300
                                          rounded-xl
                                          pl-11
                                          pr-4
                                          py-3
                                          transition" />

                        </div>

                    </div>



                    <!-- ========================================= -->
                    <!-- LƯU PROFILE -->
                    <!-- ========================================= -->

                    <button type="submit"
                            class="gold-button
                                   w-full
                                   rounded-xl
                                   py-4
                                   font-extrabold
                                   text-lg">

                        <i class="fas
                                  fa-floppy-disk
                                  mr-2">
                        </i>

                        LƯU THAY ĐỔI

                    </button>

                </form>



                <!-- ================================================= -->
                <!-- ĐỔI MẬT KHẨU -->
                <!-- ================================================= -->

                <div class="mt-10
                            pt-8
                            border-t
                            border-gray-200">


                    <div class="mb-6">

                        <h3 class="text-2xl
                                   font-bold
                                   text-gray-900">

                            <i class="fas
                                      fa-key
                                      text-yellow-600
                                      mr-2">
                            </i>

                            Đổi mật khẩu

                        </h3>


                        <p class="text-gray-500
                                  text-sm
                                  mt-2">

                            Nhập mật khẩu hiện tại trước khi
                            thiết lập mật khẩu mới.

                        </p>

                    </div>



                    <!-- ============================================= -->
                    <!-- FORM ĐỔI MẬT KHẨU -->
                    <!-- ============================================= -->

                    <form action="@Url.Action(
                                      "ChangePassword",
                                      "Account"
                                  )"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- ========================================= -->
                        <!-- MẬT KHẨU HIỆN TẠI -->
                        <!-- ========================================= -->

                        <div class="mb-5">

                            <label class="block
                                          font-semibold
                                          text-gray-700
                                          mb-2">

                                Mật khẩu hiện tại

                                <span class="text-red-500">
                                    *
                                </span>

                            </label>


                            <div class="relative">

                                <i class="fas
                                          fa-lock
                                          absolute
                                          left-4
                                          top-1/2
                                          -translate-y-1/2
                                          text-gray-400">
                                </i>


                                <input type="password"
                                       id="currentPassword"
                                       name="currentPassword"
                                       required
                                       autocomplete="current-password"
                                       placeholder="Nhập mật khẩu hiện tại"
                                       class="input-box
                                              w-full
                                              border
                                              border-gray-300
                                              rounded-xl
                                              pl-11
                                              pr-12
                                              py-3
                                              transition" />


                                <button type="button"
                                        onclick="
                                            togglePassword(
                                                'currentPassword',
                                                this
                                            )
                                        "
                                        class="absolute
                                               right-4
                                               top-1/2
                                               -translate-y-1/2
                                               text-gray-400
                                               hover:text-gray-700">

                                    <i class="fas
                                              fa-eye">
                                    </i>

                                </button>

                            </div>

                        </div>



                        <!-- ========================================= -->
                        <!-- MẬT KHẨU MỚI -->
                        <!-- ========================================= -->

                        <div class="mb-5">

                            <label class="block
                                          font-semibold
                                          text-gray-700
                                          mb-2">

                                Mật khẩu mới

                                <span class="text-red-500">
                                    *
                                </span>

                            </label>


                            <div class="relative">

                                <i class="fas
                                          fa-shield-halved
                                          absolute
                                          left-4
                                          top-1/2
                                          -translate-y-1/2
                                          text-gray-400">
                                </i>


                                <input type="password"
                                       id="newPassword"
                                       name="newPassword"
                                       required
                                       minlength="6"
                                       autocomplete="new-password"
                                       placeholder="Ít nhất 6 ký tự"
                                       class="input-box
                                              w-full
                                              border
                                              border-gray-300
                                              rounded-xl
                                              pl-11
                                              pr-12
                                              py-3
                                              transition" />


                                <button type="button"
                                        onclick="
                                            togglePassword(
                                                'newPassword',
                                                this
                                            )
                                        "
                                        class="absolute
                                               right-4
                                               top-1/2
                                               -translate-y-1/2
                                               text-gray-400
                                               hover:text-gray-700">

                                    <i class="fas
                                              fa-eye">
                                    </i>

                                </button>

                            </div>

                        </div>



                        <!-- ========================================= -->
                        <!-- XÁC NHẬN MẬT KHẨU -->
                        <!-- ========================================= -->

                        <div class="mb-7">

                            <label class="block
                                          font-semibold
                                          text-gray-700
                                          mb-2">

                                Xác nhận mật khẩu mới

                                <span class="text-red-500">
                                    *
                                </span>

                            </label>


                            <div class="relative">

                                <i class="fas
                                          fa-check-double
                                          absolute
                                          left-4
                                          top-1/2
                                          -translate-y-1/2
                                          text-gray-400">
                                </i>


                                <input type="password"
                                       id="confirmNewPassword"
                                       name="confirmNewPassword"
                                       required
                                       minlength="6"
                                       autocomplete="new-password"
                                       placeholder="Nhập lại mật khẩu mới"
                                       class="input-box
                                              w-full
                                              border
                                              border-gray-300
                                              rounded-xl
                                              pl-11
                                              pr-12
                                              py-3
                                              transition" />


                                <button type="button"
                                        onclick="
                                            togglePassword(
                                                'confirmNewPassword',
                                                this
                                            )
                                        "
                                        class="absolute
                                               right-4
                                               top-1/2
                                               -translate-y-1/2
                                               text-gray-400
                                               hover:text-gray-700">

                                    <i class="fas
                                              fa-eye">
                                    </i>

                                </button>

                            </div>

                        </div>



                        <!-- ========================================= -->
                        <!-- BUTTON ĐỔI MẬT KHẨU -->
                        <!-- ========================================= -->

                        <button type="submit"
                                class="w-full
                                       bg-gray-900
                                       hover:bg-black
                                       text-white
                                       rounded-xl
                                       py-4
                                       font-bold
                                       transition">

                            <i class="fas
                                      fa-key
                                      mr-2">
                            </i>

                            ĐỔI MẬT KHẨU

                        </button>

                    </form>

                </div>



                <!-- ================================================= -->
                <!-- LIÊN KẾT -->
                <!-- ================================================= -->

                <div class="grid
                            grid-cols-1
                            sm:grid-cols-2
                            gap-4
                            mt-8
                            pt-8
                            border-t
                            border-gray-200">


                    <!-- LỊCH SỬ -->

                    <a href="@Url.Action(
                                "Index",
                                "BookingHistory"
                             )"
                       class="border
                              border-gray-300
                              hover:bg-gray-50
                              rounded-xl
                              py-3.5
                              text-center
                              font-semibold
                              text-gray-700
                              transition">

                        <i class="fas
                                  fa-clock-rotate-left
                                  mr-2">
                        </i>

                        Lịch sử đặt phòng

                    </a>


                    <!-- ĐĂNG XUẤT -->

                    <a href="@Url.Action(
                                "Logout",
                                "Account"
                             )"
                       class="border
                              border-red-300
                              hover:bg-red-50
                              rounded-xl
                              py-3.5
                              text-center
                              font-semibold
                              text-red-600
                              transition">

                        <i class="fas
                                  fa-right-from-bracket
                                  mr-2">
                        </i>

                        Đăng xuất

                    </a>

                </div>

            </div>

        </section>

    </main>



    <!-- ========================================================= -->
    <!-- FOOTER -->
    <!-- ========================================================= -->

    <footer class="mt-12
                   bg-[#0d0a05]
                   text-gray-400
                   py-8">


        <div class="max-w-6xl
                    mx-auto
                    px-4
                    text-center
                    text-sm">

            <i class="fas
                      fa-crown
                      text-yellow-500
                      mr-2">
            </i>

            Luxury Hotel

            <span class="mx-2">
                •
            </span>

            Tài khoản thành viên

        </div>

    </footer>



    <!-- ========================================================= -->
    <!-- JAVASCRIPT -->
    <!-- ========================================================= -->

    <script>

        function togglePassword(
            inputId,
            button
        ) {

            const input =
                document.getElementById(
                    inputId
                );


            const icon =
                button.querySelector(
                    'i'
                );


            if (
                input.type ===
                'password'
            ) {

                input.type =
                    'text';


                icon.classList.remove(
                    'fa-eye'
                );


                icon.classList.add(
                    'fa-eye-slash'
                );

            }
            else {

                input.type =
                    'password';


                icon.classList.remove(
                    'fa-eye-slash'
                );


                icon.classList.add(
                    'fa-eye'
                );

            }

        }

    </script>


</body>

</html>