@model QLKhachSan.Models.RestaurantFoodAdminViewModel

@using QLKhachSan.Models
@using System.Collections.Generic

@{
    Layout = null;

    var categories =
        ViewBag.Categories
        as List<RestaurantCategoryViewModel>;
}

<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Sửa món - Luxury Hotel
    </title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>


<body class="bg-gray-100 min-h-screen">


    <div class="max-w-3xl
            mx-auto
            px-4
            py-10">


        <div class="bg-white
            rounded-2xl
            shadow-lg
            overflow-hidden">


            <div class="bg-[#201408]
                text-white
                px-7
                py-6">

                <p class="text-yellow-400
                  text-xs
                  tracking-[3px]">

                    LUXURY HOTEL RESTAURANT

                </p>

                <h1 class="text-3xl
                   font-extrabold
                   mt-2">

                    Sửa món ăn #@Model.MaMonAn

                </h1>

            </div>


            <div class="p-7">


                @if (
                    TempData["FoodError"] != null
                )
                {
                    <div class="bg-red-50
                        border
                        border-red-200
                        text-red-700
                        p-4
                        rounded-xl
                        mb-5">

                        @TempData["FoodError"]

                    </div>
                }


                <form action="@Url.Action(
                          "EditFood",
                          "Restaurant"
                      )"
                      method="post">
                    enctype="multipart/form-data"


                    <input type="hidden"
                           name="maMonAn"
                           value="@Model.MaMonAn" />
                    <input type="hidden"
                           name="hinhAnhCu"
                           value="@Model.HinhAnh" />


                    <div class="mb-5">

                        <label class="block
                              font-bold
                              mb-2">

                            Danh mục *

                        </label>


                        <select name="maDanhMuc"
                                required
                                class="w-full
                               border
                               rounded-xl
                               px-4
                               py-3">

                            @if (
                                categories != null
                            )
                            {
                                foreach (
                                    var category
                                    in categories
                                )
                                {
                                    if (
                                        Model.MaDanhMuc ==
                                        category.MaDanhMuc
                                    )
                                    {
                                        <option value="@category.MaDanhMuc"
                                                selected>

                                            @category.TenDanhMuc

                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@category.MaDanhMuc">

                                            @category.TenDanhMuc

                                        </option>
                                    }
                                }
                            }

                        </select>

                    </div>


                    <div class="mb-5">

                        <label class="block font-bold mb-2">
                            Tên món *
                        </label>

                        <input type="text"
                               name="tenMonAn"
                               value="@Model.TenMonAn"
                               required
                               class="w-full
                              border
                              rounded-xl
                              px-4
                              py-3" />

                    </div>


                    <div class="mb-5">

                        <label class="block font-bold mb-2">
                            Mô tả
                        </label>

                        <textarea name="moTa"
                                  rows="4"
                                  class="w-full
                                 border
                                 rounded-xl
                                 px-4
                                 py-3">@Model.MoTa</textarea>

                    </div>


                    <div class="grid
                        grid-cols-1
                        md:grid-cols-2
                        gap-5">


                        <div>

                            <label class="block font-bold mb-2">
                                Giá *
                            </label>

                            <input type="number"
                                   name="gia"
                                   value="@Model.Gia.ToString("0")"
                                   min="1000"
                                   step="1000"
                                   required
                                   class="w-full
                                  border
                                  rounded-xl
                                  px-4
                                  py-3" />

                        </div>


                        <div>

                            <label class="block font-bold mb-2">
                                Đơn vị
                            </label>

                            <input type="text"
                                   name="donVi"
                                   value="@Model.DonVi"
                                   class="w-full
                                  border
                                  rounded-xl
                                  px-4
                                  py-3" />

                        </div>


                        <div>

                            <label class="block font-bold mb-2">
                                Thời gian chuẩn bị
                            </label>

                            <input type="number"
                                   name="thoiGianChuanBi"
                                   value="@Model.ThoiGianChuanBi"
                                   class="w-full
                                  border
                                  rounded-xl
                                  px-4
                                  py-3" />

                        </div>


                        <div>

                            <label class="block font-bold mb-2">
                                Link ảnh
                            </label>

                            <label class="block
              font-bold
              mb-2">

                                Ảnh món

                            </label>


                            @if (
                                !string.IsNullOrWhiteSpace(
                                    Model.HinhAnh
                                )
                            )
                            {
                                <div class="mb-3">

                                    <img src="@Model.HinhAnh"
                                         id="currentFoodImage"
                                         class="w-full
                    max-w-xs
                    h-44
                    object-cover
                    rounded-xl
                    border" />

                                    <p class="text-xs
                  text-gray-400
                  mt-1">

                                        Ảnh hiện tại

                                    </p>

                                </div>
                            }


                            <input type="file"
                                   id="hinhAnhFile"
                                   name="hinhAnhFile"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   onchange="previewEditFoodImage(event)"
                                   class="w-full
              border
              rounded-xl
              px-4
              py-3
              bg-white" />


                            <p class="text-xs
          text-gray-400
          mt-2">

                                Không chọn ảnh mới nếu muốn giữ ảnh hiện tại.

                            </p>


                            <div id="editImagePreviewBox"
                                 class="hidden
            mt-4">

                                <p class="font-semibold
              text-sm
              mb-2">

                                    Ảnh mới:

                                </p>


                                <img id="editImagePreview"
                                     class="w-full
                max-w-xs
                h-44
                object-cover
                rounded-xl
                border" />

                            </div>

                        </div>

                    </div>


                    <div class="grid
                        grid-cols-1
                        md:grid-cols-2
                        gap-4
                        mt-6">


                        <label class="border
                              rounded-xl
                              p-4
                              flex
                              gap-3
                              items-center">

                            <input type="checkbox"
                                   name="noiBat"
                                   value="true"
                                   @(Model.NoiBat ? "checked" : "") />

                            Món nổi bật

                        </label>


                        <label class="border
                              rounded-xl
                              p-4
                              flex
                              gap-3
                              items-center">

                            <input type="checkbox"
                                   name="hoatDong"
                                   value="true"
                                   @(Model.HoatDong ? "checked" : "") />

                            Đang bán

                        </label>

                    </div>


                    <div class="flex gap-3 mt-7">

                        <a href="@Url.Action(
                            "ManageFoods",
                            "Restaurant"
                         )"
                           class="border
                          rounded-xl
                          px-6
                          py-3
                          font-bold">

                            Quay lại

                        </a>


                        <button type="submit"
                                class="flex-1
                               bg-yellow-500
                               hover:bg-yellow-600
                               font-extrabold
                               rounded-xl
                               py-3">

                            LƯU THAY ĐỔI

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
    <script>

        function previewEditFoodImage(event) {

            const file =
                event.target.files[0];


            const box =
                document.getElementById(
                    'editImagePreviewBox'
                );


            const image =
                document.getElementById(
                    'editImagePreview'
                );


            if (!file) {

                box.classList.add(
                    'hidden'
                );

                return;

            }


            if (
                file.size >
                2 * 1024 * 1024
            ) {
                alert(
                    'Ảnh không được vượt quá 2MB.'
                );


                event.target.value =
                    '';


                box.classList.add(
                    'hidden'
                );

                return;

            }


            const reader =
                new FileReader();


            reader.onload =
                function (e) {

                    image.src =
                        e.target.result;


                    box.classList.remove(
                        'hidden'
                    );

                };


            reader.readAsDataURL(
                file
            );

        }

    </script>

</body>

</html>