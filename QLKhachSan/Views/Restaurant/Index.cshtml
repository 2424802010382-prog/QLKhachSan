                        return food.id === id;

                    }
                );


            if (!item) {

                return;

            }


            item.quantity +=
                amount;


            if (
                item.quantity <= 0
            ) {

                restaurantCart =
                    restaurantCart.filter(
                        function (food) {

                            return food.id !== id;

                        }
                    );

