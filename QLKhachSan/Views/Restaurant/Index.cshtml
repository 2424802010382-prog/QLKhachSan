@model QLKhachSan.Models.RestaurantIndexViewModel

@using System.Globalization
@using System.Linq

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Nhà hàng - Luxury Hotel
    </title>


    <script src="https://cdn.tailwindcss.com"></script>


    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />


    <style>

        body {
            background: #f8f5ee;
            color: #2a2118;
        }


        .restaurant-header {
            background: linear-gradient( 135deg, #0d0905, #2b1b0c );
        }


        .hero-restaurant {
            background: linear-gradient( 135deg, #1b1108, #3d250e, #171009 );
        }


        .food-card {
            background: #fffdf8;
            border: 1px solid #ead9b4;
            transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
        }


            .food-card:hover {
                transform: translateY(-5px);
                border-color: #d7a918;
                box-shadow: 0 18px 40px rgba(52, 35, 15, .13);
            }


        .category-button.active {
            background: #d5a817;
            color: #161009;
            border-color: #d5a817;
        }


        .cart-drawer {
            transition: transform .3s ease;
        }
    </style>

</head>


<body class="min-h-screen">


    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <header class="restaurant-header
                   text-white
                   sticky
                   top-0
                   z-40
                   shadow-xl">


        <div class="max-w-7xl
                    mx-auto
                    px-4
                    py-4
                    flex
                    items-center
                    justify-between
                    gap-4">


            <!-- LOGO -->

            <a href="@Url.Action(
                        "Index",
                        "Home"
                     )"
               class="flex
                      items-center
                      gap-3">


                <div class="w-12
                            h-12
                            border
                            border-yellow-500
                            flex
                            items-center
                            justify-center
                            text-yellow-400">

                    <i class="fas fa-crown"></i>

                </div>


                <div>

                    <div class="font-extrabold
                                text-xl">

                        LUXURY HOTEL

                    </div>

                    <div class="text-yellow-400
                                text-[10px]
                                tracking-[3px]">

                        RESTAURANT

                    </div>

                </div>

            </a>



            <!-- RIGHT -->

            <div class="flex
                        items-center
                        gap-3">


                <a href="@Url.Action(
                            "Index",
                            "Home"
                         )"
                   class="hidden
                          md:inline-flex
                          items-center
                          gap-2
                          text-sm
                          text-yellow-100
                          hover:text-yellow-400">

                    <i class="fas fa-house"></i>

                    Trang chủ

                </a>
                @if (Session["UserId"] != null)
                {
                    <a href="@Url.Action(
                "History",
                "Restaurant"
             )"
                       class="hidden
              md:inline-flex
              items-center
              gap-2
              text-sm
              text-yellow-100
              hover:text-yellow-400">

                        <i class="fas fa-clock-rotate-left"></i>

                        Lịch sử gọi món

                    </a>
                }

                <!-- CART BUTTON -->

                <button type="button"
                        onclick="openCart()"
                        class="relative
                               bg-yellow-500
                               hover:bg-yellow-400
                               text-black
                               font-bold
                               px-4
                               py-2.5
                               rounded-xl
                               transition">

                    <i class="fas
                              fa-cart-shopping
                              mr-2">
                    </i>

                    Giỏ món


                    <span id="cartCount"
                          class="absolute
                                 -top-2
                                 -right-2
                                 min-w-6
                                 h-6
                                 px-1
                                 bg-red-600
                                 text-white
                                 rounded-full
                                 text-xs
                                 flex
                                 items-center
                                 justify-center">

                        0

                    </span>

                </button>

            </div>

        </div>

    </header>



    <!-- ========================================================= -->
    <!-- HERO -->
    <!-- ========================================================= -->

    <section class="hero-restaurant
                    text-white
                    py-20
                    px-4">


        <div class="max-w-5xl
                    mx-auto
                    text-center">


            <p class="text-yellow-400
                      font-bold
                      tracking-[5px]
                      text-sm
                      mb-4">

                LUXURY HOTEL RESTAURANT

            </p>


            <h1 class="text-4xl
                       md:text-6xl
                       font-extrabold
                       mb-5">

                Tinh Hoa Ẩm Thực
                <span class="text-yellow-400">
                    Á - Âu
                </span>

            </h1>


            <p class="max-w-2xl
                      mx-auto
                      text-gray-300
                      leading-7">

                Thưởng thức thực đơn đa dạng
                được chế biến từ nguyên liệu
                chọn lọc bởi đội ngũ đầu bếp
                của Luxury Hotel.

            </p>

        </div>

    </section>



    <!-- ========================================================= -->
    <!-- SEARCH + CATEGORY -->
    <!-- ========================================================= -->

    <section class="bg-white
                    border-b
                    border-yellow-100
                    sticky
                    top-[80px]
                    z-30">


        <div class="max-w-7xl
                    mx-auto
                    px-4
                    py-5">


            <!-- SEARCH -->

            <div class="max-w-xl
                        mx-auto
                        relative
                        mb-5">


                <i class="fas
                          fa-magnifying-glass
                          absolute
                          left-4
                          top-1/2
                          -translate-y-1/2
                          text-gray-400">
                </i>


                <input type="text"
                       id="foodSearch"
                       oninput="applyFoodFilter()"
                       placeholder="Tìm món ăn..."
                       class="w-full
                              border
                              border-gray-300
                              rounded-xl
                              py-3
                              pl-11
                              pr-4
                              focus:ring-2
                              focus:ring-yellow-500
                              focus:outline-none" />

            </div>



            <!-- CATEGORY -->

            <div class="flex
                        gap-3
                        overflow-x-auto
                        pb-1
                        justify-start
                        md:justify-center">


                <button type="button"
                        class="category-button
                               active
                               whitespace-nowrap
                               border
                               border-yellow-500
                               rounded-full
                               px-5
                               py-2
                               font-bold"
                        data-category="all"
                        onclick="selectCategory(this)">

                    Tất cả

                </button>


                @foreach (
                    var category
                    in Model.Categories
                )
                {
                    <button type="button"
                            class="category-button
                                   whitespace-nowrap
                                   border
                                   border-yellow-500
                                   rounded-full
                                   px-5
                                   py-2
                                   font-bold
                                   hover:bg-yellow-50"
                            data-category="@category.MaDanhMuc"
                            onclick="selectCategory(this)">

                        @category.TenDanhMuc

                    </button>
                }

            </div>

        </div>

    </section>



    <!-- ========================================================= -->
    <!-- DANH SÁCH MÓN -->
    <!-- ========================================================= -->

    <main class="max-w-7xl
                 mx-auto
                 px-4
                 py-12">


        <div class="flex
                    flex-col
                    md:flex-row
                    md:items-end
                    md:justify-between
                    gap-4
                    mb-8">


            <div>

                <p class="text-yellow-700
                          font-bold
                          tracking-[3px]
                          text-xs">

                    THỰC ĐƠN

                </p>


                <h2 class="text-3xl
                           md:text-4xl
                           font-extrabold
                           mt-2">

                    Khám Phá Món Ngon

                </h2>

            </div>


            <p id="foodResultCount"
               class="text-gray-500">

                @Model.Foods.Count món

            </p>

        </div>



        <!-- FOOD GRID -->

        <div id="foodGrid"
             class="grid
                    grid-cols-1
                    sm:grid-cols-2
                    lg:grid-cols-3
                    xl:grid-cols-4
                    gap-6">


            @foreach (
                var food
                in Model.Foods
            )
            {
                string searchText =
                    (
                        (food.TenMonAn ?? "")
                        + " "
                        + (food.MoTa ?? "")
                        + " "
                        + (food.TenDanhMuc ?? "")
                    )
                    .ToLower();


                <article class="food-card
                                rounded-2xl
                                overflow-hidden"
                         data-food-card
                         data-category="@food.MaDanhMuc"
                         data-search="@searchText">


                    <!-- IMAGE -->

                    <div class="h-52
                                bg-gradient-to-br
                                from-yellow-100
                                to-yellow-50
                                relative
                                overflow-hidden">


                        @if (
                            !string.IsNullOrWhiteSpace(
                                food.HinhAnh
                            )
                        )
                        {
                            <img src="@food.HinhAnh"
                                 alt="@food.TenMonAn"
                                 class="w-full
                                        h-full
                                        object-cover" />
                        }
                        else
                        {
                            <div class="w-full
                                        h-full
                                        flex
                                        items-center
                                        justify-center
                                        text-yellow-600
                                        text-6xl">

                                <i class="fas
                                          fa-utensils">
                                </i>

                            </div>
                        }


                        <!-- CATEGORY -->

                        <span class="absolute
                                     left-4
                                     top-4
                                     bg-black/75
                                     text-yellow-300
                                     px-3
                                     py-1
                                     rounded-full
                                     text-xs
                                     font-bold">

                            @food.TenDanhMuc

                        </span>


                        @if (food.NoiBat)
                        {
                            <span class="absolute
                                         right-4
                                         top-4
                                         bg-yellow-500
                                         text-black
                                         px-3
                                         py-1
                                         rounded-full
                                         text-xs
                                         font-extrabold">

                                <i class="fas
                                          fa-star
                                          mr-1">
                                </i>

                                Nổi bật

                            </span>
                        }

                    </div>



                    <!-- CONTENT -->

                    <div class="p-5">


                        <h3 class="text-xl
                                   font-extrabold
                                   text-gray-900
                                   mb-2">

                            @food.TenMonAn

                        </h3>


                        <p class="text-sm
                                  text-gray-500
                                  leading-6
                                  min-h-[48px]">

                            @food.MoTa

                        </p>



                        <!-- TIME -->

                        <div class="mt-4
                                    text-sm
                                    text-gray-500">


                            @if (
                                food.ThoiGianChuanBi.HasValue
                            )
                            {
                                <span>

                                    <i class="fas
                                              fa-clock
                                              text-yellow-600
                                              mr-1">
                                    </i>

                                    Khoảng
                                    @food.ThoiGianChuanBi
                                    phút

                                </span>
                            }

                        </div>



                        <!-- PRICE -->

                        <div class="mt-5
                                    flex
                                    items-end
                                    justify-between
                                    gap-3">


                            <div>

                                <p class="text-xs
                                          text-gray-400">

                                    Giá

                                </p>


                                <p class="text-xl
                                          font-extrabold
                                          text-yellow-700">

                                    @food.Gia.ToString("N0")đ

                                </p>


                                <p class="text-xs
                                          text-gray-400">

                                    / @food.DonVi

                                </p>

                            </div>



                            <!-- ADD -->

                            <button type="button"
                                    class="add-food-button
                                           bg-yellow-500
                                           hover:bg-yellow-600
                                           text-gray-900
                                           font-bold
                                           px-4
                                           py-3
                                           rounded-xl
                                           transition"
                                    data-id="@food.MaMonAn"
                                    data-name="@food.TenMonAn"
                                    data-price="@food.Gia.ToString(
                                                    "0",
                                                    CultureInfo.InvariantCulture
                                                )"
                                    data-unit="@food.DonVi"
                                    onclick="addFoodFromButton(this)">

                                <i class="fas
                                          fa-plus
                                          mr-1">
                                </i>

                                Thêm

                            </button>

                        </div>

                    </div>

                </article>
            }

        </div>



        <!-- EMPTY -->

        <div id="foodEmpty"
             class="hidden
                    text-center
                    py-20">


            <i class="fas
                      fa-bowl-food
                      text-6xl
                      text-gray-300
                      mb-5">
            </i>


            <h3 class="text-2xl
                       font-bold
                       text-gray-600">

                Không tìm thấy món ăn

            </h3>


            <p class="text-gray-400
                      mt-2">

                Hãy thử từ khóa hoặc danh mục khác.

            </p>

        </div>

    </main>


    <!-- ========================================================= -->
    <!-- MODAL XÁC NHẬN ĐẶT MÓN -->
    <!-- ========================================================= -->

    <div id="orderModal"
         class="fixed
            inset-0
            bg-black/70
            hidden
            items-center
            justify-center
            p-4
            z-[60]">


        <div class="bg-white
                max-w-2xl
                w-full
                max-h-[92vh]
                overflow-y-auto
                rounded-2xl
                shadow-2xl
                relative">


            <!-- HEADER -->

            <div class="bg-[#201408]
                    text-white
                    px-7
                    py-6">


                <button type="button"
                        onclick="closeOrderModal()"
                        class="absolute
                           top-4
                           right-5
                           w-9
                           h-9
                           rounded-full
                           bg-white/10
                           hover:bg-white/20">

                    <i class="fas fa-times"></i>

                </button>


                <p class="text-yellow-400
                      text-xs
                      tracking-[3px]
                      font-bold">

                    LUXURY HOTEL RESTAURANT

                </p>


                <h2 class="text-3xl
                       font-extrabold
                       mt-2">

                    Xác Nhận Đặt Món

                </h2>

            </div>



            <!-- BODY -->

            <div class="p-7">


                <!-- TỔNG -->

                <div class="bg-yellow-50
                        border
                        border-yellow-200
                        rounded-xl
                        p-5
                        flex
                        justify-between
                        items-center
                        mb-7">

                    <span class="font-semibold
                             text-gray-600">

                        Tổng đơn hàng

                    </span>


                    <span id="orderModalTotal"
                          class="font-extrabold
                             text-2xl
                             text-yellow-700">

                        0đ

                    </span>

                </div>



                <!-- HỌ TÊN -->

                <div class="mb-5">

                    <label class="block
                              font-semibold
                              mb-2">

                        Họ và tên *

                    </label>


                    <input type="text"
                           id="orderCustomerName"
                           value="@(Session["FullName"] ?? "")"
                           class="w-full
                              border
                              border-gray-300
                              rounded-xl
                              px-4
                              py-3
                              focus:ring-2
                              focus:ring-yellow-500
                              focus:outline-none"
                           placeholder="Nhập họ và tên" />

                </div>



                <!-- PHONE -->

                <div class="mb-6">

                    <label class="block
                              font-semibold
                              mb-2">

                        Số điện thoại *

                    </label>


                    <input type="tel"
                           id="orderPhone"
                           maxlength="11"
                           class="w-full
                              border
                              border-gray-300
                              rounded-xl
                              px-4
                              py-3
                              focus:ring-2
                              focus:ring-yellow-500
                              focus:outline-none"
                           placeholder="Ví dụ: 0901234567" />

                </div>



                <!-- HÌNH THỨC -->

                <h3 class="font-bold
                       text-lg
                       mb-4">

                    Bạn muốn nhận món ở đâu?

                </h3>


                <div class="grid
                        grid-cols-1
                        sm:grid-cols-2
                        gap-4
                        mb-5">


                    <label class="border
                              border-yellow-300
                              rounded-xl
                              p-4
                              cursor-pointer
                              hover:bg-yellow-50">

                        <input type="radio"
                               name="orderType"
                               value="Ăn tại nhà hàng"
                               checked
                               onchange="updateOrderTypeFields()"
                               class="mr-2" />

                        <i class="fas
                              fa-utensils
                              text-yellow-600
                              mr-2">
                        </i>

                        <strong>
                            Ăn tại nhà hàng
                        </strong>

                    </label>


                    <label class="border
                              border-yellow-300
                              rounded-xl
                              p-4
                              cursor-pointer
                              hover:bg-yellow-50">

                        <input type="radio"
                               name="orderType"
                               value="Giao lên phòng"
                               onchange="updateOrderTypeFields()"
                               class="mr-2" />

                        <i class="fas
                              fa-bell-concierge
                              text-yellow-600
                              mr-2">
                        </i>

                        <strong>
                            Giao lên phòng
                        </strong>

                    </label>

                </div>



                <!-- SỐ BÀN -->

                <div id="tableNumberBox"
                     class="mb-5">

                    <label class="block
                              font-semibold
                              mb-2">

                        Số bàn *

                    </label>


                    <input type="text"
                           id="orderTableNumber"
                           maxlength="20"
                           class="w-full
                              border
                              border-gray-300
                              rounded-xl
                              px-4
                              py-3"
                           placeholder="Ví dụ: Bàn 05" />

                </div>



                <!-- SỐ PHÒNG -->

                <div id="roomNumberBox"
                     class="hidden
                        mb-5">

                    <label class="block
                              font-semibold
                              mb-2">

                        Số phòng *

                    </label>


                    <input type="text"
                           id="orderRoomNumber"
                           maxlength="20"
                           class="w-full
                              border
                              border-gray-300
                              rounded-xl
                              px-4
                              py-3"
                           placeholder="Ví dụ: 305" />

                </div>



                <!-- GHI CHÚ -->

                <div class="mb-5">

                    <label class="block
                              font-semibold
                              mb-2">

                        Ghi chú

                    </label>


                    <textarea id="orderNote"
                              rows="3"
                              maxlength="1000"
                              class="w-full
                                 border
                                 border-gray-300
                                 rounded-xl
                                 px-4
                                 py-3"
                              placeholder="Ví dụ: Không cay, không hành..."></textarea>

                </div>



                <!-- PAYMENT -->

                <div class="mb-7">

                    <label class="block
                              font-semibold
                              mb-2">

                        Phương thức thanh toán *

                    </label>


                    <select id="orderPaymentMethod"
                            class="w-full
                               border
                               border-gray-300
                               rounded-xl
                               px-4
                               py-3">

                        <option value="Thanh toán khi nhận món">
                            Thanh toán khi nhận món
                        </option>

                        <option value="Chuyển khoản">
                            Chuyển khoản
                        </option>

                    </select>

                </div>



                <!-- ERROR -->

                <div id="orderError"
                     class="hidden
                        mb-5
                        bg-red-50
                        border
                        border-red-200
                        text-red-700
                        rounded-xl
                        px-4
                        py-3">
                </div>



                <!-- SUBMIT -->

                <button type="button"
                        id="placeOrderButton"
                        onclick="submitRestaurantOrder()"
                        class="w-full
                           bg-yellow-500
                           hover:bg-yellow-600
                           text-gray-900
                           font-extrabold
                           py-4
                           rounded-xl">

                    <i class="fas
                          fa-circle-check
                          mr-2">
                    </i>

                    XÁC NHẬN ĐẶT MÓN

                </button>

            </div>

        </div>

    </div>
    <!-- ========================================================= -->
    <!-- CART OVERLAY -->
    <!-- ========================================================= -->

    <div id="cartOverlay"
         onclick="closeCart()"
         class="fixed
                inset-0
                bg-black/60
                hidden
                z-40">
    </div>



    <!-- ========================================================= -->
    <!-- CART DRAWER -->
    <!-- ========================================================= -->

    <aside id="cartDrawer"
           class="cart-drawer
                  fixed
                  top-0
                  right-0
                  h-full
                  w-full
                  sm:w-[430px]
                  bg-white
                  z-50
                  shadow-2xl
                  translate-x-full
                  flex
                  flex-col">


        <!-- HEADER -->

        <div class="bg-[#201408]
                    text-white
                    px-6
                    py-5
                    flex
                    items-center
                    justify-between">


            <div>

                <h2 class="text-2xl
                           font-extrabold">

                    Giỏ Món

                </h2>


                <p class="text-yellow-300
                          text-sm">

                    Luxury Hotel Restaurant

                </p>

            </div>


            <button type="button"
                    onclick="closeCart()"
                    class="w-10
                           h-10
                           rounded-full
                           bg-white/10
                           hover:bg-white/20">

                <i class="fas fa-times"></i>

            </button>

        </div>



        <!-- ITEMS -->

        <div id="cartItems"
             class="flex-1
                    overflow-y-auto
                    p-5">

        </div>



        <!-- FOOTER -->

        <div class="border-t
                    p-5
                    bg-[#fffdf8]">


            <div class="flex
                        items-center
                        justify-between
                        mb-5">


                <span class="text-gray-500
                             font-semibold">

                    Tổng cộng

                </span>


                <span id="cartTotal"
                      class="text-2xl
                             font-extrabold
                             text-yellow-700">

                    0đ

                </span>

            </div>


            <button type="button"
                    onclick="continueOrder()"
                    class="w-full
                           bg-yellow-500
                           hover:bg-yellow-600
                           text-gray-900
                           font-extrabold
                           py-4
                           rounded-xl
                           transition">

                <i class="fas
                          fa-receipt
                          mr-2">
                </i>

                TIẾP TỤC ĐẶT MÓN

            </button>


            <button type="button"
                    onclick="clearCart()"
                    class="w-full
                           mt-3
                           border
                           border-gray-300
                           hover:bg-gray-100
                           text-gray-600
                           font-semibold
                           py-3
                           rounded-xl">

                Xóa toàn bộ giỏ

            </button>

        </div>

    </aside>



    <!-- ========================================================= -->
    <!-- JAVASCRIPT -->
    <!-- ========================================================= -->

    <script>

        let activeCategory =
            'all';


        let restaurantCart =
            [];


        // =======================================================
        // CHUẨN HÓA CHỮ TÌM KIẾM
        // =======================================================

        function normalizeText(value) {

            return (value || '')
                .toLowerCase()
                .normalize('NFD')
                .replace(
                    /[\u0300-\u036f]/g,
                    ''
                )
                .replace(
                    /đ/g,
                    'd'
                );

        }



        // =======================================================
        // CATEGORY
        // =======================================================

        function selectCategory(button) {

            document
                .querySelectorAll(
                    '.category-button'
                )
                .forEach(
                    function (item) {

                        item.classList.remove(
                            'active'
                        );

                    }
                );


            button.classList.add(
                'active'
            );


            activeCategory =
                button.dataset.category;


            applyFoodFilter();

        }



        // =======================================================
        // SEARCH + FILTER
        // =======================================================

        function applyFoodFilter() {

            const keyword =
                normalizeText(
                    document.getElementById(
                        'foodSearch'
                    ).value
                );


            let visibleCount =
                0;


            document
