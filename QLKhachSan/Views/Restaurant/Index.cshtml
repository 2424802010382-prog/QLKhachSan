                    'text-sm mt-2">' +
                    'Hãy chọn món bạn yêu thích.' +
                    '</p>' +

                    '</div>';


                return;

            }


            container.innerHTML =
                '';


            restaurantCartFix
                .forEach(
                    function (item) {

                        const row =
                            document.createElement(
                                'div'
                            );


                        row.className =
                            'border-b ' +
                            'border-gray-100 ' +
                            'py-5';


                        row.innerHTML =

                            '<div class="' +
                            'flex justify-between gap-3">' +

                            '<div class="flex-1">' +

                            '<p class="' +
                            'font-bold text-gray-900">' +

                            restaurantEscapeHtml(
                                item.name
                            ) +

                            '</p>' +

                            '<p class="' +
                            'text-yellow-700 ' +
                            'font-bold text-sm mt-1">' +

                            restaurantFormatMoney(
                                item.price
                            ) +

                            ' / ' +

                            restaurantEscapeHtml(
                                item.unit
                            ) +

                            '</p>' +

                            '</div>' +


                            '<button type="button" ' +
                            'onclick="removeRestaurantFoodFix(' +
                            Number(item.id) +
                            ')" ' +

                            'class="' +
                            'text-red-500 ' +
                            'hover:text-red-700">' +

                            '<i class="' +
                            'fas fa-trash">' +
                            '</i>' +

                            '</button>' +

                            '</div>' +


                            '<div class="' +
                            'flex items-center ' +
                            'justify-between mt-4">' +


                            '<div class="' +
                            'flex items-center gap-2">' +


                            '<button type="button" ' +
                            'onclick="' +
                            'changeRestaurantFoodQuantityFix(' +
                            Number(item.id) +
                            ', -1)" ' +

                            'class="' +
                            'w-9 h-9 ' +
                            'border rounded-full">' +

                            '<i class="' +
                            'fas fa-minus">' +
                            '</i>' +

                            '</button>' +


                            '<span class="' +
                            'w-8 text-center ' +
                            'font-bold">' +

                            Number(
                                item.quantity
                            ) +

                            '</span>' +


                            '<button type="button" ' +
                            'onclick="' +
                            'changeRestaurantFoodQuantityFix(' +
                            Number(item.id) +
                            ', 1)" ' +

                            'class="' +
                            'w-9 h-9 ' +
                            'bg-yellow-500 ' +
                            'rounded-full">' +

                            '<i class="' +
                            'fas fa-plus">' +
                            '</i>' +

                            '</button>' +

                            '</div>' +


                            '<strong>' +

                            restaurantFormatMoney(
                                Number(
                                    item.price
                                )
                                *
                                Number(
                                    item.quantity
                                )
                            ) +

                            '</strong>' +

                            '</div>';


                        container.appendChild(
                            row
                        );

                    }
                );

        }


        // =========================================================
        // TĂNG GIẢM
        // =========================================================

        window.changeRestaurantFoodQuantityFix =
            function (
                id,
                amount
            ) {

                const item =
                    restaurantCartFix
                        .find(
                            function (food) {

                                return (
                                    Number(food.id) ===
                                    Number(id)
                                );

                            }
                        );


                if (!item) {

                    return;

                }


                item.quantity =
                    Number(
                        item.quantity
                    )
                    +
                    Number(
                        amount
                    );


                if (
                    item.quantity <= 0
                ) {

                    restaurantCartFix =
                        restaurantCartFix
                            .filter(
                                function (food) {

                                    return (
                                        Number(food.id)
                                        !==
                                        Number(id)
                                    );

                                }
                            );

                }


                saveRestaurantCartFix();

                renderRestaurantCartFix();

            };


        // =========================================================
        // XÓA MÓN
        // =========================================================

        window.removeRestaurantFoodFix =
            function (id) {

                restaurantCartFix =
                    restaurantCartFix
                        .filter(
                            function (food) {

                                return (
                                    Number(food.id)
                                    !==
                                    Number(id)
                                );

                            }
                        );


                saveRestaurantCartFix();

                renderRestaurantCartFix();

            };


        // =========================================================
        // MỞ GIỎ
        // =========================================================

        window.openCart =
            function () {

                const overlay =
                    document.getElementById(
                        'cartOverlay'
                    );


                const drawer =
                    document.getElementById(
                        'cartDrawer'
                    );


                if (overlay) {

                    overlay.classList.remove(
                        'hidden'
                    );

                }


                if (drawer) {

                    drawer.classList.remove(
                        'translate-x-full'
                    );

                }


                renderRestaurantCartFix();

            };


        // =========================================================
        // ĐÓNG GIỎ
        // =========================================================

        window.closeCart =
            function () {

                const overlay =
                    document.getElementById(
                        'cartOverlay'
                    );


                const drawer =
                    document.getElementById(
                        'cartDrawer'
                    );


                if (overlay) {

                    overlay.classList.add(
                        'hidden'
                    );

                }


                if (drawer) {

                    drawer.classList.add(
                        'translate-x-full'
                    );

                }

            };


        // =========================================================
        // XÓA TOÀN GIỎ
        // =========================================================

        window.clearCart =
            function () {

                if (
                    restaurantCartFix.length ===
                    0
                ) {

                    return;

                }


                if (
                    !confirm(
                        'Bạn có chắc muốn xóa toàn bộ giỏ món?'
                    )
                ) {

                    return;

                }


                restaurantCartFix =
                    [];


                saveRestaurantCartFix();

                renderRestaurantCartFix();

            };

        // =========================================================
        // TIẾP TỤC ĐẶT MÓN
        // =========================================================

        window.continueOrder =
            function () {

                // =====================================================
                // 1. KIỂM TRA GIỎ
                // =====================================================

                if (
                    !restaurantCartFix ||
                    restaurantCartFix.length === 0
                ) {

                    alert(
                        'Vui lòng chọn ít nhất một món.'
                    );

                    return;

                }


                // =====================================================
                // 2. ĐÓNG GIỎ MÓN
                // =====================================================

                closeCart();


                // =====================================================
                // 3. TÍNH TỔNG ĐƠN
                // =====================================================

                let total =
                    0;


                restaurantCartFix.forEach(
                    function (item) {

                        total +=
                            Number(item.price)
                            *
                            Number(item.quantity);

                    }
                );


                // =====================================================
                // 4. TÌM MODAL XÁC NHẬN ĐẶT MÓN
                // =====================================================

                const modal =
                    document.getElementById(
                        'orderModal'
                    );


                if (!modal) {

                    alert(
                        'Chưa tìm thấy giao diện xác nhận đặt món.'
                    );

                    return;

                }


                // =====================================================
                // 5. HIỆN TỔNG TIỀN
                // =====================================================

                const totalElement =
                    document.getElementById(
                        'orderModalTotal'
                    );


                if (totalElement) {

                    totalElement.innerText =
                        restaurantFormatMoney(
                            total
                        );

                }


                // =====================================================
                // 6. ẨN LỖI CŨ
                // =====================================================

                const errorBox =
                    document.getElementById(
                        'orderError'
                    );


                if (errorBox) {

                    errorBox.classList.add(
                        'hidden'
                    );

                    errorBox.innerText =
                        '';

                }


                // =====================================================
                // 7. HIỆN SỐ BÀN / SỐ PHÒNG
                // =====================================================

                if (
                    typeof updateOrderTypeFields
                    ===
                    'function'
                ) {

                    updateOrderTypeFields();

                }


                // =====================================================
                // 8. MỞ MODAL
                // =====================================================

                modal.classList.remove(
                    'hidden'
                );


                modal.classList.add(
                    'flex'
                );

            };
        // =========================================================
        // ĐÓNG MODAL XÁC NHẬN ĐẶT MÓN
        // =========================================================

        window.closeOrderModal =
            function () {

                const modal =
                    document.getElementById(
                        'orderModal'
                    );


                if (!modal) {

                    return;

                }


                modal.classList.add(
                    'hidden'
                );


                modal.classList.remove(
                    'flex'
                );

            };

        // =========================================================
        // ĐỔI SỐ BÀN / SỐ PHÒNG
        // =========================================================

        window.updateOrderTypeFields =
            function () {

                const selected =
                    document.querySelector(
                        'input[name="orderType"]:checked'
                    );


                const type =
                    selected
                        ? selected.value
                        : 'Ăn tại nhà hàng';


                const tableBox =
                    document.getElementById(
                        'tableNumberBox'
                    );


                const roomBox =
                    document.getElementById(
                        'roomNumberBox'
                    );


                if (
                    !tableBox ||
                    !roomBox
                ) {

                    return;

                }


                if (
                    type ===
                    'Giao lên phòng'
                ) {

                    tableBox.classList.add(
                        'hidden'
                    );


                    roomBox.classList.remove(
                        'hidden'
                    );

                }
                else {

                    roomBox.classList.add(
                        'hidden'
                    );


                    tableBox.classList.remove(
                        'hidden'
                    );

                }

            };
        // =========================================================
        // HIỂN THỊ LỖI ĐẶT MÓN
        // =========================================================

        function showRestaurantOrderErrorFix(
            message
        ) {

            const errorBox =
                document.getElementById(
                    'orderError'
                );


            if (!errorBox) {

                return;

            }


            errorBox.innerText =
                message;


            errorBox.classList.remove(
                'hidden'
            );

        }
        // =========================================================
// XÁC NHẬN ĐẶT MÓN
// =========================================================

window.submitRestaurantOrder =
    async function () {

        // =====================================================
        // LẤY CÁC CONTROL
        // =====================================================

        const nameInput =
            document.getElementById(
                'orderCustomerName'
            );


        const phoneInput =
            document.getElementById(
                'orderPhone'
            );


        const tableInput =
            document.getElementById(
                'orderTableNumber'
            );


        const roomInput =
            document.getElementById(
                'orderRoomNumber'
            );


        const noteInput =
            document.getElementById(
                'orderNote'
            );


        const paymentInput =
            document.getElementById(
                'orderPaymentMethod'
            );


        // =====================================================
        // LẤY GIÁ TRỊ
        // =====================================================

        const name =
            nameInput
            ? nameInput.value.trim()
            : '';


        const phone =
            phoneInput
            ? phoneInput.value.trim()
            : '';


        const tableNumber =
            tableInput
            ? tableInput.value.trim()
            : '';


        const roomNumber =
            roomInput
            ? roomInput.value.trim()
            : '';


        const note =
            noteInput
            ? noteInput.value.trim()
            : '';


        const paymentMethod =
            paymentInput
            ? paymentInput.value
            : '';


        const selectedType =
            document.querySelector(
                'input[name="orderType"]:checked'
            );


        const type =
            selectedType
            ? selectedType.value
            : '';


        // =====================================================
        // XÓA LỖI CŨ
        // =====================================================

        const errorBox =
            document.getElementById(
                'orderError'
            );


        if (errorBox) {

            errorBox.innerText =
                '';


            errorBox.classList.add(
                'hidden'
            );

        }


        // =====================================================
        // KIỂM TRA HỌ TÊN
        // =====================================================

        if (!name) {

            showRestaurantOrderErrorFix(
                'Vui lòng nhập họ và tên.'
            );

            return;

        }


        // =====================================================
        // KIỂM TRA SĐT
        // =====================================================

        if (
            !/^[0-9]{10,11}$/
                .test(phone)
        ) {

            showRestaurantOrderErrorFix(
                'Số điện thoại phải gồm 10 đến 11 chữ số.'
            );

            return;

        }


        // =====================================================
        // KIỂM TRA HÌNH THỨC
        // =====================================================

        if (
            type !==
            'Ăn tại nhà hàng'
            &&
            type !==
            'Giao lên phòng'
        ) {

            showRestaurantOrderErrorFix(
                'Vui lòng chọn hình thức nhận món.'
            );

            return;

        }


        // =====================================================
        // KIỂM TRA SỐ BÀN
        // =====================================================

        if (
            type ===
            'Ăn tại nhà hàng'
            &&
            !tableNumber
        ) {

            showRestaurantOrderErrorFix(
                'Vui lòng nhập số bàn.'
            );

            return;

        }


        // =====================================================
        // KIỂM TRA SỐ PHÒNG
        // =====================================================

        if (
            type ===
            'Giao lên phòng'
            &&
            !roomNumber
        ) {

            showRestaurantOrderErrorFix(
                'Vui lòng nhập số phòng.'
            );

            return;

        }


        // =====================================================
        // KIỂM TRA GIỎ
        // =====================================================

        if (
            !restaurantCartFix ||
            restaurantCartFix.length === 0
        ) {

            showRestaurantOrderErrorFix(
                'Giỏ món đang trống.'
            );

            return;

        }


        // =====================================================
        // TẠO DỮ LIỆU GỬI SERVER
        // =====================================================

        const data =
            {

                HoTen:
                    name,

                SoDienThoai:
                    phone,

                HinhThuc:
                    type,

                SoBan:
                    type ===
                    'Ăn tại nhà hàng'
                    ? tableNumber
                    : null,

                SoPhong:
                    type ===
                    'Giao lên phòng'
                    ? roomNumber
                    : null,

                GhiChu:
                    note,

                PhuongThucThanhToan:
                    paymentMethod,

                Items:
                    restaurantCartFix.map(
                        function (item) {

                            return {

                                MaMonAn:
                                    Number(
                                        item.id
                                    ),

                                SoLuong:
                                    Number(
                                        item.quantity
                                    )

                            };

                        }
                    )

            };


        // =====================================================
        // BUTTON
        // =====================================================

        const button =
            document.getElementById(
                'placeOrderButton'
            );


        if (!button) {

            return;

        }


        button.disabled =
            true;


        button.innerHTML =
            '<i class="' +
            'fas fa-spinner fa-spin mr-2">' +
            '</i>' +
            'ĐANG XỬ LÝ...';


        try {

            // =================================================
            // GỬI ĐƠN
            // =================================================

            const response =
                await fetch(
                    '@Url.Action(
                        "PlaceOrder",
                        "Restaurant"
                    )',
                    {
                        method:
                            'POST',

                        headers:
                            {
                                'Content-Type':
                                    'application/json'
                            },

                        body:
                            JSON.stringify(
                                data
                            )
                    }
                );


            // =================================================
            // HTTP ERROR
            // =================================================

            if (!response.ok) {

                throw new Error(
                    'HTTP '
                    +
                    response.status
                );

            }


            const result =
                await response.json();


            // =================================================
            // SERVER TỪ CHỐI
            // =================================================

            if (!result.success) {

                showRestaurantOrderErrorFix(
                    result.message
                    ||
                    'Không thể đặt món.'
                );

                return;

            }


            // =================================================
            // THÀNH CÔNG
            // =================================================

            restaurantCartFix =
                [];


            saveRestaurantCartFix();


            renderRestaurantCartFix();


            closeOrderModal();


            alert(
                'ĐẶT MÓN THÀNH CÔNG!\\n\\n'
                +
                'Mã đơn: #'
                +
                result.orderId
                +
                '\\n'
                +
                'Tổng tiền: '
                +
                restaurantFormatMoney(
                    result.totalAmount
                )
            );


            // =================================================
            // RESET FORM
            // =================================================

            if (phoneInput) {

                phoneInput.value =
                    '';

            }


            if (tableInput) {

                tableInput.value =
                    '';

            }


            if (roomInput) {

                roomInput.value =
                    '';

            }


            if (noteInput) {

                noteInput.value =
                    '';

            }

        }
        catch (error) {

            console.error(
                error
            );


            showRestaurantOrderErrorFix(
                'Không thể kết nối tới hệ thống đặt món.'
            );

        }
        finally {

            button.disabled =
                false;


            button.innerHTML =
                '<i class="' +
                'fas fa-circle-check mr-2">' +
                '</i>' +
                'XÁC NHẬN ĐẶT MÓN';

        }

    };

        // =========================================================
        // LOAD
        // =========================================================

        document.addEventListener(
            'DOMContentLoaded',
            function () {

                loadRestaurantCartFix();

                applyRestaurantFoodFilter();

            }
        );

    </script>
</body>

</html>