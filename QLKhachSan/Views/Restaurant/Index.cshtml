// =======================================================

function updateOrderTypeFields() {

    const selected =
        document.querySelector(
            'input[name="orderType"]:checked'
        );


    const type =
        selected
        ? selected.value
        : 'Ăn tại nhà hàng';


    const tableBox =
        document.getElementById(
            'tableNumberBox'
        );


    const roomBox =
        document.getElementById(
            'roomNumberBox'
        );


    if (
        type ===
        'Giao lên phòng'
    ) {

        tableBox.classList.add(
            'hidden'
        );


        roomBox.classList.remove(
            'hidden'
        );

    }
    else {

        roomBox.classList.add(
            'hidden'
        );


        tableBox.classList.remove(
            'hidden'
        );

    }

}


// =======================================================
// HIỆN LỖI
// =======================================================

function showOrderError(
    message
) {

    const error =
        document.getElementById(
            'orderError'
        );


    error.innerText =
        message;


    error.classList.remove(
        'hidden'
    );

}


