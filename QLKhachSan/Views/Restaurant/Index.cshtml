// TÍNH TỔNG GIỎ
// =======================================================

function calculateRestaurantCartTotal() {

    let total =
        0;


    restaurantCart.forEach(
        function (item) {

            total +=
                Number(item.price)
                *
                Number(item.quantity);

        }
    );


    return total;

}


