        function validateGuestCapacity() {

            const guestSelect =
                document.getElementById(
                    'guestCount'
                );

            const roomCountSelect =
                document.getElementById(
                    'roomCount'
                );

            const message =
                document.getElementById(
                    'capacityMessage'
                );


            if (
                !guestSelect ||
                !roomCountSelect ||
                !message
            ) {

                return true;
            }


            const guestCount =
                parseInt(
                    guestSelect.value
                );


            const roomCount =
                parseInt(
                    roomCountSelect.value
                ) || 1;


            // Chưa chọn phòng
            if (selectedRoomCapacity <= 0) {

                message.innerText = '';

                return true;
            }


            // Sức chứa tối đa
            const maxGuests =
                selectedRoomCapacity *
                roomCount;


            // Chưa chọn số người
            if (!guestCount) {

                message.innerText =
                    'Tối đa '
                    + maxGuests
                    + ' người cho '
                    + roomCount
                    + ' phòng.';

                message.className =
                    'mt-2 text-sm font-semibold text-gray-500';

                return true;
            }


            // ===================================================
            // VƯỢT QUÁ SỨC CHỨA
            // ===================================================

            if (guestCount > maxGuests) {

                message.innerText =
                    'Số người vượt quá sức chứa. '
                    + roomCount
                    + ' phòng chỉ chứa tối đa '
                    + maxGuests
                    + ' người.';

                message.className =
                    'mt-2 text-sm font-semibold text-red-600';

                return false;
            }


            // ===================================================
            // HỢP LỆ
            // ===================================================

            message.innerText =
