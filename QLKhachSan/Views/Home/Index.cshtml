        function validateServiceQuantity(input) {

            let quantity =
                Number(input.value);


            // Không phải số nguyên hoặc nhỏ hơn 1
            if (
                !Number.isInteger(quantity) ||
                quantity < 1
            ) {

                quantity = 1;

            }


            // Không cho vượt quá 20
            if (quantity > 20) {

                quantity = 20;

            }


            // Gán lại giá trị đã chuẩn hóa
            input.value =
                quantity;


            // Tính lại tổng tiền
            updateBookingSummary();
        }
        // =======================================================
        // TỰ CHỌN DỊCH VỤ ĐƯỢC GHI NHỚ TỪ MODAL ẨM THỰC
        // =======================================================

        function applyPendingDiningService() {

            const serviceId =
                sessionStorage.getItem(
                    'pendingDiningServiceId'
                );


            if (!serviceId) {

                return;

            }


            const checkbox =
                document.querySelector(
                    '.service-checkbox[value="' +
                    serviceId +
                    '"]'
                );


            if (!checkbox) {

                return;

            }


            // Tick dịch vụ
            checkbox.checked =
                true;


            // Hiện ô số lượng
            toggleServiceQuantity(
                checkbox
            );


            const card =
                checkbox.closest(
                    '.service-card'
                );


            if (card) {

                // Làm nổi bật dịch vụ vừa được chọn
                card.classList.add(
                    'border-yellow-500',
                    'bg-yellow-50'
                );


                const quantity =
                    card.querySelector(
                        '.service-quantity'
                    );


                if (quantity) {

                    quantity.value =
                        1;

                }

            }


            // Xóa khỏi bộ nhớ để lần đặt tiếp theo
            // không tự chọn lại
            sessionStorage.removeItem(
                'pendingDiningServiceId'
            );


            updateBookingSummary();

        }
    // =======================================================
    // HIỆN Ô SỐ LƯỢNG KHI CHỌN DỊCH VỤ
