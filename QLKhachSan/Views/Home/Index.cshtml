            /* =======================================================
               CHỌN PHÒNG TỪ MENU
            ======================================================= */
            function showRoomType(roomType) {
                showPage("rooms");
                const map = { "DELUXE": "Phòng Deluxe", "PREMIUM": "Phòng Premium", "LUXURY BALCONY SUITE": "Phòng Luxury Balcony Suite", "PHÒNG TỔNG THỐNG": "Phòng Tổng Thống", "STANDARD": "Phòng Standard", "SUPERIOR": "Phòng Superior", "TWIN ROOM": "Phòng Twin", "FAMILY ROOM": "Phòng Family" };
                const name = map[roomType];
                setTimeout(() => { document.querySelectorAll("#page-rooms .luxury-room-card").forEach(card => { const h = card.querySelector("h4"); if (h && h.innerText.trim() === name) { card.scrollIntoView({ behavior: "smooth", block: "center" }); card.classList.add("room-highlight"); setTimeout(() => card.classList.remove("room-highlight"), 1800) } }) }, 100);
        }
            // =======================================================
// MỞ TRANG CHI TIẾT PHÒNG TỪ MENU
// =======================================================

function openRoomDetail(roomType) {

    // ===================================================
    // CHUẨN HÓA CHỮ ĐỂ SO SÁNH
    // Ví dụ:
    // "Phòng Tổng Thống"
    // -> "PHONG TONG THONG"
    // ===================================================

    function normalizeRoomText(text) {

        return (text || '')
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .replace(/Đ/g, 'D')
            .replace(/đ/g, 'd')
            .trim()
            .toUpperCase();
    }


    const selectedType =
        normalizeRoomText(roomType);


    // ===================================================
    // CÁC TỪ KHÓA TƯƠNG ỨNG VỚI TỪNG PHÒNG
    // ===================================================

    const roomAliases = {

        'DELUXE': [
            'DELUXE'
        ],

        'PREMIUM': [
            'PREMIUM'
        ],

        'LUXURY BALCONY SUITE': [
            'LUXURY BALCONY SUITE',
            'LUXURY',
            'SUITE'
        ],

        'PHONG TONG THONG': [
            'PHONG TONG THONG',
            'TONG THONG',
            'PRESIDENT'
        ],

        'STANDARD': [
            'STANDARD'
        ],

        'SUPERIOR': [
            'SUPERIOR'
        ],

        'TWIN ROOM': [
            'TWIN ROOM',
            'TWIN'
        ],

        'FAMILY ROOM': [
            'FAMILY ROOM',
            'FAMILY'
        ]
    };


    const keywords =
        roomAliases[selectedType] ||
        [selectedType];


    // ===================================================
    // LẤY TẤT CẢ CARD PHÒNG
    // ===================================================

    const cards =
        document.querySelectorAll(
            '#page-rooms .luxury-room-card'
        );


    let foundRoomId = null;


    cards.forEach(function (card) {

        if (foundRoomId) {
            return;
        }


        const roomId =
            card.getAttribute(
                'data-room-id'
            );


        const roomName =
            normalizeRoomText(
                card.getAttribute(
                    'data-room-name'
                )
            );


        const roomDbType =
            normalizeRoomText(
                card.getAttribute(
                    'data-room-type'
                )
            );


        const combinedText =
            roomName +
            ' ' +
            roomDbType;


        const matched =
            keywords.some(function (keyword) {

                return combinedText.includes(
                    normalizeRoomText(keyword)
                );

            });


        if (matched) {

            foundRoomId = roomId;

        }

    });


    // ===================================================
    // KHÔNG TÌM THẤY
    // ===================================================

    if (!foundRoomId) {

        alert(
            'Không tìm thấy thông tin phòng '
            + roomType
            + '.'
        );

        return;
    }


    // ===================================================
    // CHUYỂN SANG RoomController -> Details
    // ===================================================

    const detailsUrl =
        '@Url.Action("Details", "Room")'
        + '?id='
        + encodeURIComponent(
            foundRoomId
        );


    window.location.href =
        detailsUrl;
}

