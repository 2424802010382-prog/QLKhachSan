            ======================================================= */
        // =======================================================
        // CHỐNG BẤM XÁC NHẬN ĐẶT PHÒNG NHIỀU LẦN
        // =======================================================

        let bookingSubmitting = false;


        function setBookingSubmitting(isSubmitting) {

            bookingSubmitting =
                isSubmitting;


            const button =
                document.getElementById(
                    'submitBookingButton'
                );

            const text =
                document.getElementById(
                    'submitBookingText'
                );

            const icon =
                document.getElementById(
                    'submitBookingIcon'
                );


            if (!button || !text || !icon) {
                return;
            }


            button.disabled =
                isSubmitting;


            if (isSubmitting) {

                text.innerText =
                    'Đang xử lý...';

                icon.className =
                    'fas fa-spinner fa-spin mr-2';

            }
            else {

                text.innerText =
                    'Xác nhận đặt phòng';

                icon.className =
                    'fas fa-check-circle mr-2';

            }
        }
            async function submitBooking(event) {

                event.preventDefault();


                // Nếu request trước đang chạy
                // thì không cho gửi thêm
                if (bookingSubmitting) {

                    return;

                }


                const data = {

            RoomId:
                parseInt(
                    document.getElementById('selectedRoomId').value
                ),

            CustomerName:
                document.getElementById('customerName').value.trim(),

            CustomerPhone:
                document.getElementById('customerPhone').value.trim(),

            CustomerEmail:
                document.getElementById('customerEmail').value.trim(),

            CustomerCCCD:
                document.getElementById('customerCCCD').value.trim(),

            CheckInDate:
                document.getElementById('checkInDate').value,

            CheckOutDate:
                document.getElementById('checkOutDate').value,

            GuestCount:
                parseInt(
                    document.getElementById('guestCount').value
                ),

            RoomCount:
                parseInt(
                    document.getElementById('roomCount').value
                ),

            SpecialRequest:
                document.getElementById(
                    'specialRequest'
                ).value.trim(),

            PaymentMethod:
                document.getElementById(
                    'paymentMethod'
                ).value,

            PromotionCode:
                appliedPromotion
                    ? document.getElementById(
                          'promotionCode'
                      ).value.trim()
                    : '',

            Services:
                getSelectedServices()
        };


        if (!data.RoomId) {

            alert('Vui lòng chọn phòng trước!');

            showPage('rooms');

            return;
        }


        if (data.CheckOutDate <= data.CheckInDate) {

            alert('Ngày trả phòng phải sau ngày nhận phòng!');

            return;
        }

                // =======================================================
                // KIỂM TRA SỨC CHỨA TRƯỚC KHI GỬI ĐẶT PHÒNG
                // =======================================================

                if (!validateGuestCapacity()) {

                    alert(
                        'Số người vượt quá sức chứa của số phòng đã chọn.'
                    );

                    document
                        .getElementById(
                            'guestCount'
                        )
                        .focus();

                    return;
                }
                // =======================================================
                // DỮ LIỆU ĐÃ HỢP LỆ
                // BẮT ĐẦU KHÓA NÚT VÀ GỬI REQUEST
                // =======================================================

                setBookingSubmitting(true);
        try {

            const response = await fetch(
                '@Url.Action("Create", "Booking")',
                {
                    method: 'POST',

                    headers: {
                        'Content-Type': 'application/json'
                    },

                    body: JSON.stringify(data)
                }
            );


            const result = await response.json();


            if (!result.success) {

                // Cho phép khách sửa rồi bấm lại
                setBookingSubmitting(false);


                alert(
                    result.message
                );


                return;
            }


            const total =
                Number(result.totalAmount)
                    .toLocaleString('vi-VN');
            const discount =
                Number(
                    result.discountAmount || 0
                ).toLocaleString('vi-VN');


            alert(
                'ĐẶT PHÒNG THÀNH CÔNG!\n\n' +
                'Mã đặt phòng: #' +
                result.bookingId + '\n' +

                'Tiền giảm: ' +
                discount + 'đ\n' +

                'Tổng thanh toán: ' +
                total + 'đ\n' +

                'Trạng thái: Chờ xác nhận'
            );


            document
                .getElementById('bookingForm')
                .reset();


            document
                .getElementById('selectedRoomId')
                .value = '';
            resetPaymentState();

            selectedRoomPrice = 0;
            selectedRoomCapacity = 0;

            appliedPromotion = null;
            const capacityMessage =
                document.getElementById(
                    'capacityMessage'
                );

            if (capacityMessage) {

                capacityMessage.innerText = '';

            }

            document.getElementById(
                'promotionMessage'
            ).innerText = '';

            updateBookingSummary();
            setBookingSubmitting(false);
            showPage('home');

        }
        catch (error) {

            console.error(error);


            // Có lỗi mạng thì cho phép bấm lại
            setBookingSubmitting(false);


            alert(
                'Không thể kết nối đến máy chủ. Vui lòng thử lại!'
            );
        }
    }
            /* =======================================================
    THANH TOÁN CHUYỂN KHOẢN QR
    ======================================================= */

            // Biến đếm ngược
            let countdownInterval = null;

            // Thời gian 10 phút = 600 giây
            let remainingSeconds = 600;

            // Trạng thái thanh toán
        let paymentExpired = false;

        let currentTransferContent = null;


            // Thông tin ngân hàng mẫu
            const BANK_ID = "Vietcombank";

            const ACCOUNT_NO = "1038619653";

            const ACCOUNT_NAME = "LUXURY HOTEL";

            // Khi chọn phương thức thanh toán
            function togglePaymentMethod() {

                const paymentMethod =
                    document.getElementById("paymentMethod").value;

                const qrSection =
                    document.getElementById("qrPaymentSection");

                // Nếu chọn chuyển khoản
                if (paymentMethod === "Chuyển khoản") {

                    qrSection.classList.remove("hidden");

                    // Tạo mã QR
                    generateQRCode();

                    // Bắt đầu đếm ngược
                    startCountdown();

                }

                // Nếu chọn thanh toán tại khách sạn
                else {

                    qrSection.classList.add("hidden");

                    stopCountdown();

                }

            }

            // Tạo mã QR
            function generateQRCode() {

                // Dùng đúng tổng tiền đang hiển thị trên form
                // (tiền phòng + dịch vụ - khuyến mãi)
                const totals =
                    calculateBookingTotals();

                const totalAmount =
                    totals.total;

                // Mã nội dung chuyển khoản
                if (!currentTransferContent) {

                    currentTransferContent =
                        "LUXURYHOTEL" +
                        Date.now()
                            .toString()
                            .slice(-6);
                }

                const transferContent =
                    currentTransferContent;

                // URL tạo mã QR VietQR
                const qrUrl =
                    "https://img.vietqr.io/image/" +
                    BANK_ID + "-" +
                    ACCOUNT_NO +
                    "-compact2.png" +
                    "?amount=" + totalAmount +
                    "&addInfo=" +
                    encodeURIComponent(transferContent) +
                    "&accountName=" +
                    encodeURIComponent(ACCOUNT_NAME);

                // Hiển thị QR
                document.getElementById("qrImage").src =
                    qrUrl;

                // Hiển thị số tiền
                document.getElementById("qrAmount").innerText =
                    totalAmount.toLocaleString("vi-VN") + "đ";

                // Hiển thị nội dung
                document.getElementById("qrContent").innerText =
                    transferContent;

            }

            // Bắt đầu đếm ngược 10 phút
            function startCountdown() {

                // Nếu đang đếm thì không tạo thêm
                if (countdownInterval !== null) {

                    return;

                }

                // Nếu lệnh đã hết hạn thì không chạy
                if (paymentExpired) {

                    return;

                }

                remainingSeconds = 600;

                updateCountdownDisplay();

                countdownInterval = setInterval(function () {

                    remainingSeconds--;

                    updateCountdownDisplay();

                    // Khi hết giờ
                    if (remainingSeconds <= 0) {

                        stopCountdown();

                        cancelPayment();

                    }

                }, 1000);

            }

            // Hiển thị thời gian
            function updateCountdownDisplay() {

                const minutes =
                    Math.floor(remainingSeconds / 60);

                const seconds =
                    remainingSeconds % 60;

                const formattedTime =
                    String(minutes).padStart(2, "0") +
                    ":" +
                    String(seconds).padStart(2, "0");

                const timer =
                    document.getElementById("countdownTimer");

                if (timer) {

                    timer.innerText = formattedTime;

                }

            }

            // Dừng đếm ngược
        function stopCountdown() {


                if (countdownInterval !== null) {

                    clearInterval(countdownInterval);

                    countdownInterval = null;

                }

        }
        // =======================================================
        // RESET THANH TOÁN QR CHO LƯỢT ĐẶT PHÒNG MỚI
        // =======================================================

        function resetPaymentState() {

            // Dừng bộ đếm cũ
            stopCountdown();


            // Reset biến
            remainingSeconds = 600;
            paymentExpired = false;

            // Quan trọng:
            // bỏ mã giao dịch của lần đặt trước
            currentTransferContent = null;


            // Reset thời gian về 10 phút
            const timer =
                document.getElementById(
                    "countdownTimer"
                );

            if (timer) {
                timer.innerText = "10:00";
            }


            // Reset trạng thái thanh toán
            const status =
                document.getElementById(
                    "paymentStatus"
                );

            if (status) {

                status.innerText =
                    "Đang chờ thanh toán...";

                status.className =
                    "mt-5 text-center text-sm text-gray-600";
            }


            // Mở lại nút "Tôi đã chuyển khoản"
            const button =
                document.getElementById(
                    "paymentDoneButton"
                );

            if (button) {

                button.disabled = false;

                button.classList.remove(
                    "opacity-50"
                );
            }


            // Xóa QR CŨ
            const qrImage =
                document.getElementById(
                    "qrImage"
                );

            if (qrImage) {
                qrImage.removeAttribute("src");
            }


            // Reset số tiền QR
            const qrAmount =
                document.getElementById(
                    "qrAmount"
                );

            if (qrAmount) {
                qrAmount.innerText = "0đ";
            }


            // Reset nội dung chuyển khoản
            const qrContent =
                document.getElementById(
                    "qrContent"
                );

            if (qrContent) {
                qrContent.innerText = "---";
            }


            // Đưa phương thức thanh toán về mặc định
            const paymentMethod =
                document.getElementById(
                    "paymentMethod"
                );

            if (paymentMethod) {

                paymentMethod.value =
                    "Thanh toán tại khách sạn";
            }


            // Ẩn khu QR ngay lập tức
            const qrSection =
                document.getElementById(
                    "qrPaymentSection"
                );

            if (qrSection) {
                qrSection.classList.add(
                    "hidden"
                );
            }
        }

            // Xác nhận đã chuyển khoản
            function confirmPayment() {

                if (paymentExpired) {

                    alert("Lệnh thanh toán đã hết hạn!");

                    return;

                }

                stopCountdown();

                document.getElementById("paymentStatus").innerText =
                    "Đã ghi nhận yêu cầu xác nhận thanh toán. Vui lòng chờ khách sạn kiểm tra giao dịch.";

                document.getElementById("paymentStatus").className =
                    "mt-5 text-center text-sm text-green-600 font-semibold";

                document.getElementById("paymentDoneButton").disabled =
                    true;

                alert(
                    "Đã ghi nhận yêu cầu thanh toán.\n\n" +
                    "Khách sạn sẽ kiểm tra giao dịch chuyển khoản."
                );

            }

            // Tự động hủy khi hết 10 phút
            function cancelPayment() {

                paymentExpired = true;

                const status =
                    document.getElementById("paymentStatus");

                status.innerText =
                    "Lệnh thanh toán đã hết hạn và tự động hủy.";

                status.className =
                    "mt-5 text-center text-sm text-red-600 font-bold";

                const timer =
                    document.getElementById("countdownTimer");

                timer.innerText = "00:00";

                const button =
                    document.getElementById("paymentDoneButton");

                button.disabled = true;

                button.classList.add("opacity-50");

                alert(
                    "Lệnh thanh toán đã hết hạn!\n\n" +
                    "Đặt phòng chưa được xác nhận."
                );

            }

    </script>
