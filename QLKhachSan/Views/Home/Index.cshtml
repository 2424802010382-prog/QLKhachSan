                'hidden'
            );


            modal.classList.remove(
                'flex'
            );

        }


        function openAIFromSupport() {

            closeSupport24Modal();


            const chatBox =
                document.getElementById(
                    'aiChatBox'
                );


            // Nếu chatbot đang đóng thì mở
            if (
                chatBox &&
                (
                    chatBox.style.display === 'none' ||
                    chatBox.style.display === ''
                )
            ) {

                toggleAIChat();

            }


            // Điền sẵn câu hỏi
            setTimeout(
                function () {

                    const input =
                        document.getElementById(
                            'aiMessageInput'
                        );


                    if (input) {

                        input.value =
                            'Tôi cần hỗ trợ 24/7';


                        input.focus();

                    }

                },
                150
            );

        }
        // =======================================================
// ẨM THỰC
// =======================================================

function openDiningModal() {

    const modal =
        document.getElementById(
            'diningModal'
        );


    modal.classList.remove(
        'hidden'
    );


    modal.classList.add(
        'flex'
    );


    loadDiningServices();

}


function closeDiningModal() {

    const modal =
        document.getElementById(
            'diningModal'
        );


    modal.classList.add(
        'hidden'
    );


    modal.classList.remove(
        'flex'
    );

}


// =======================================================
// TẢI DỊCH VỤ ẨM THỰC TỪ DATABASE
// =======================================================

function loadDiningServices() {

    const loading =
        document.getElementById(
            'diningLoading'
        );


    const container =
        document.getElementById(
            'diningServices'
        );


    const empty =
        document.getElementById(
            'diningEmpty'
        );


    loading.classList.remove(
        'hidden'
    );


    empty.classList.add(
        'hidden'
    );


    container.innerHTML = '';


    fetch(
        '@Url.Action("GetServices", "Booking")'
    )
        .then(function (response) {

            if (!response.ok) {

                throw new Error(
                    'Không tải được dịch vụ'
                );

            }


            return response.json();

        })
        .then(function (services) {

            loading.classList.add(
                'hidden'
            );


            if (!Array.isArray(services)) {

                empty.classList.remove(
                    'hidden'
                );

                return;

            }


            const diningServices =
                services.filter(
                    function (service) {

                        const name =
                            (
                                service.name || ''
                            )
                            .toLowerCase();


                        return (
                            name.includes('buffet') ||
                            name.includes('ăn') ||
                            name.includes('bữa') ||
                            name.includes('ẩm thực') ||
                            name.includes('food') ||
                            name.includes('breakfast')
                        );

                    }
                );


            if (
                diningServices.length === 0
            ) {

                empty.classList.remove(
                    'hidden'
                );

                return;

            }


            diningServices.forEach(
                function (service) {

                    const card =
                        document.createElement(
                            'div'
                        );


                    card.className =
                        'border border-yellow-200 ' +
                        'bg-yellow-50 rounded-xl p-5';


                    const price =
                        Number(
                            service.price || 0
                        )
                        .toLocaleString(
                            'vi-VN'
                        );


                    card.innerHTML =
                        '<div class="flex items-start gap-4">' +

                            '<div class="' +
                                'w-12 h-12 rounded-full ' +
                                'bg-yellow-500 text-gray-900 ' +
                                'flex items-center justify-center ' +
                                'flex-shrink-0">' +

                                '<i class="fas fa-utensils"></i>' +

                            '</div>' +

                            '<div class="flex-1">' +

                                '<h3 class="' +
                                    'font-bold text-lg text-gray-900">' +

                                    escapeDiningHtml(
                                        service.name || ''
                                    ) +

                                '</h3>' +

                                '<p class="' +
                                    'text-sm text-gray-500 mt-1">' +

                                    escapeDiningHtml(
                                        service.description || ''
                                    ) +

                                '</p>' +

                                '<div class="' +
                                    'mt-4 flex justify-between ' +
                                    'items-end gap-3">' +

                                    '<span class="' +
                                        'font-extrabold text-yellow-700">' +

                                        price +
                                        'đ' +

                                    '</span>' +

                                    '<span class="' +
                                        'text-xs text-gray-500">' +

                                        escapeDiningHtml(
                                            service.unit || ''
                                        ) +

                                    '</span>' +

                                '</div>' +

                            '</div>' +

                        '</div>';

                    const chooseButton =
                        document.createElement(
                            'button'
                        );


                    chooseButton.type =
                        'button';


                    chooseButton.className =
                        'w-full mt-4 ' +
                        'bg-yellow-500 ' +
                        'hover:bg-yellow-600 ' +
                        'text-gray-900 ' +
                        'font-bold ' +
                        'py-2.5 ' +
                        'rounded-lg ' +
                        'transition';


                    chooseButton.innerHTML =
                        '<i class="fas fa-plus-circle mr-2"></i>' +
                        'Chọn dịch vụ này';


                    chooseButton.onclick =
                        function () {

                            chooseDiningService(
                                service.id
                            );

                        };


                    card.appendChild(
                        chooseButton
                    );
                    container.appendChild(
                        card
                    );

                }
            );

        })
        .catch(function () {

            loading.classList.add(
                'hidden'
            );


            empty.classList.remove(
                'hidden'
            );

        });

}


        // =======================================================
        // CHỌN DỊCH VỤ TỪ MODAL ẨM THỰC
        // =======================================================

        function chooseDiningService(
            serviceId
        ) {

            // Ghi nhớ dịch vụ khách vừa chọn
            sessionStorage.setItem(
                'pendingDiningServiceId',
                String(serviceId)
            );


            // Đóng modal ẩm thực
            closeDiningModal();


            // Đưa khách sang danh sách phòng
            showPage(
                'rooms'
            );


            // Thông báo
            setTimeout(
                function () {

                    alert(
                        'Đã ghi nhớ dịch vụ.\\n\\n' +
                        'Hãy chọn phòng bạn muốn đặt.\\n' +
                        'Dịch vụ sẽ tự được chọn trong form đặt phòng.'
                    );

                },
                150
            );

        }
// =======================================================
// CHỐNG CHÈN HTML TỪ DỮ LIỆU
// =======================================================

function escapeDiningHtml(value) {

    const div =
        document.createElement(
            'div'
        );


    div.textContent =
        value || '';


    return div.innerHTML;

}

    </script>


