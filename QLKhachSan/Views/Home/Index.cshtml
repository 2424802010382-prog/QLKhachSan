    function toggleServiceQuantity(checkbox) {

        const card =
            checkbox.closest('.service-card');

        const quantityBox =
            card.querySelector('.service-quantity-box');


        if (checkbox.checked) {

            // Hiện ô nhập số lượng
            quantityBox.classList.remove(
                'hidden'
            );

        }
        else {

            // Ẩn ô nhập số lượng
            quantityBox.classList.add(
                'hidden'
            );


            // Khi bỏ chọn dịch vụ
            // đưa số lượng về 1
            const quantityInput =
                card.querySelector(
                    '.service-quantity'
                );


            if (quantityInput) {

                quantityInput.value = '1';

            }

        }


        // Tính lại tổng tiền
        updateBookingSummary();
    }



