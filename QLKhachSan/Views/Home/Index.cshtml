@model IEnumerable<QLKhachSan.Models.Room>

<!DOCTYPE html>
@{
    Layout = null;
}

<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Luxury Hotel - Trang Chủ</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <style>

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f8fafc;
            color: #1e293b;
        }

        .page-section {
            display: none;
        }

            .page-section.active {
                display: block;
                animation: fadeIn 0.5s ease-in-out;
            }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(15px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .luxury-navbar {
            background: linear-gradient( 135deg, #0f172a, #1e3a8a, #1d4ed8 );
            box-shadow: 0 5px 25px rgba(15, 23, 42, 0.25);
        }

        .luxury-logo {
            letter-spacing: 2px;
            text-shadow: 0 3px 8px rgba(0, 0, 0, 0.25);
        }
        /* ========================================================= */
        /* MENU PHÒNG - DROPDOWN */
        /* ========================================================= */

        .room-dropdown {
            position: relative;
        }

        .room-dropdown-button {
            position: relative;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
        }

        .room-dropdown-menu {
            position: absolute;
            top: calc(100% + 10px);
            left: 0;
            width: 260px;
            background: #303030;
            border-radius: 0;
            box-shadow: 0 10px 30px rgba(0,0,0,0.35);
            overflow: hidden;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition: all 0.25s ease;
            z-index: 100;
        }

        .room-dropdown:hover .room-dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .room-dropdown-item {
            display: block;
            width: 100%;
            padding: 13px 18px;
            color: #f5f5f5;
            background: #303030;
            border-bottom: 1px solid #424242;
            font-size: 14px;
            font-weight: 500;
            text-align: left;
            transition: all 0.2s ease;
        }

            .room-dropdown-item:last-child {
                border-bottom: none;
            }

            .room-dropdown-item:hover {
                background: #444444;
                color: #facc15;
                padding-left: 23px;
            }

            .room-dropdown-item i {
                width: 18px;
                margin-right: 6px;
                color: #facc15;
            }

        .luxury-menu-link {
            position: relative;
            transition: all 0.3s ease;
        }

            .luxury-menu-link::after {
                content: "";
                position: absolute;
                left: 50%;
                bottom: 0;
                width: 0;
                height: 3px;
                background: #facc15;
                transform: translateX(-50%);
                transition: width 0.3s ease;
                border-radius: 10px;
            }

            .luxury-menu-link:hover::after {
                width: 75%;
            }

        .hero-section {
            min-height: 680px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

            .hero-section::before {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient( 135deg, rgba(15, 23, 42, 0.85), rgba(30, 64, 175, 0.55), rgba(0, 0, 0, 0.45) );
                z-index: 1;
            }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .hero-title {
            font-size: clamp(2.3rem, 6vw, 5rem);
            line-height: 1.15;
            font-weight: 900;
            letter-spacing: -1px;
            text-shadow: 0 5px 20px rgba(0, 0, 0, 0.45);
        }

        .hero-description {
            font-size: clamp(1rem, 2vw, 1.3rem);
            line-height: 1.8;
        }

        .search-box {
            background: rgba(255, 255, 255, 0.97);
            border-radius: 24px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
            backdrop-filter: blur(12px);
        }

        .section-title {
            position: relative;
            display: inline-block;
            font-weight: 800;
            color: #0f172a;
        }

            .section-title::after {
                content: "";
                display: block;
                width: 80px;
                height: 5px;
                margin: 15px auto 0;
                border-radius: 20px;
                background: linear-gradient( 90deg, #2563eb, #facc15 );
            }

        .feature-card {
            background: white;
            border-radius: 24px;
            padding: 35px 28px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 8px 25px rgba(15, 23, 42, 0.07);
            transition: all 0.35s ease;
        }

            .feature-card:hover {
                transform: translateY(-10px);
                box-shadow: 0 20px 45px rgba(37, 99, 235, 0.18);
                border-color: #93c5fd;
            }

        .feature-icon {
            width: 75px;
            height: 75px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 25px;
            border-radius: 50%;
            color: #2563eb;
            background: linear-gradient( 135deg, #dbeafe, #eff6ff );
            transition: all 0.35s ease;
        }

        .feature-card:hover .feature-icon {
            color: white;
            background: linear-gradient( 135deg, #2563eb, #1e40af );
            transform: rotate(8deg) scale(1.08);
        }

        .room-card {
            overflow: hidden;
            background: white;
            border-radius: 24px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
            transition: all 0.35s ease;
        }

            .room-card:hover {
                transform: translateY(-10px);
                box-shadow: 0 22px 50px rgba(15, 23, 42, 0.18);
            }

            .room-card img {
                transition: transform 0.5s ease;
            }

            .room-card:hover img {
                transform: scale(1.08);
            }

        .room-image-wrapper {
            overflow: hidden;
            position: relative;
            height: 240px;
            flex-shrink: 0;
        }
            .room-image-wrapper img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .room-price {
            color: #1d4ed8;
            font-size: 1.4rem;
            font-weight: 800;
        }

        .main-button {
            background: linear-gradient( 135deg, #2563eb, #1d4ed8 );
            color: white;
            font-weight: 700;
            border-radius: 12px;
            padding: 13px 22px;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(37, 99, 235, 0.25);
        }

            .main-button:hover {
                transform: translateY(-3px);
                background: linear-gradient( 135deg, #1d4ed8, #1e3a8a );
                box-shadow: 0 10px 25px rgba(37, 99, 235, 0.4);
            }

        .yellow-button {
            background: linear-gradient( 135deg, #facc15, #eab308 );
            color: #172554;
            font-weight: 800;
            border-radius: 12px;
            padding: 13px 22px;
            transition: all 0.3s ease;
        }

            .yellow-button:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 25px rgba(234, 179, 8, 0.35);
            }

        .page-banner {
            position: relative;
            background-size: cover;
            background-position: center;
            padding: 110px 20px;
            color: white;
            text-align: center;
        }

            .page-banner::before {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient( 135deg, rgba(15, 23, 42, 0.88), rgba(30, 64, 175, 0.65) );
            }

        .page-banner-content {
            position: relative;
            z-index: 2;
        }

        .form-card {
            background: white;
            border-radius: 24px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 15px 45px rgba(15, 23, 42, 0.1);
        }

        input,
        select,
        textarea {
            transition: all 0.25s ease;
        }

            input:focus,
            select:focus,
            textarea:focus {
                border-color: #2563eb !important;
                box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
                outline: none;
            }

        .footer-section {
            background: linear-gradient( 135deg, #020617, #0f172a, #172554 );
        }

        .modal-box {
            animation: modalShow 0.3s ease;
        }

        @@keyframes modalShow {
            from {
                opacity: 0;
                transform: scale(0.9) translateY(20px);
            }

            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        #aiChatButton {
            transition: all 0.3s ease;
        }

            #aiChatButton:hover {
                transform: scale(1.12) rotate(5deg);
                box-shadow: 0 12px 35px rgba(37, 99, 235, 0.5) !important;
            }

        #aiChatBox {
            animation: chatShow 0.3s ease;
        }

        @@keyframes chatShow {
            from {
                opacity: 0;
                transform: translateY(20px) scale(0.95);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        @@media (max-width: 768px) {

            .hero-section {
                min-height: 760px;
            }

            .hero-title {
                font-size: 2.5rem;
            }

            .search-box {
                padding: 20px !important;
            }

            .luxury-logo {
                font-size: 1.2rem;
            }

            #aiChatBox {
                right: 15px !important;
                bottom: 100px !important;
                width: calc(100% - 30px) !important;
                height: 480px !important;
            }

            #aiChatButton {
                right: 18px !important;
                bottom: 18px !important;
                width: 58px !important;
                height: 58px !important;
            }
        }

        /* ===== LUXURY GOLD THEME ===== */
        body {
            background: #f7f2e8;
            color: #2b2117
        }

        .luxury-navbar {
            background: rgba(25,18,12,.94) !important;
            box-shadow: 0 5px 25px rgba(0,0,0,.28) !important;
            border-bottom: 1px solid rgba(212,175,55,.55);
            backdrop-filter: blur(12px)
        }

        .luxury-logo {
            color: #f5d77a !important;
            letter-spacing: 2px
        }

        .luxury-crown-logo {
            width: 54px;
            height: 54px;
            border: 2px solid #d4af37;
            color: #f5d77a;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px
        }

            .luxury-crown-logo.small {
                width: 52px;
                height: 52px;
                font-size: 21px
            }

        .luxury-menu-link {
            color: #f8f3e8 !important
        }

            .luxury-menu-link:hover {
                color: #f5d77a !important;
                background: rgba(212,175,55,.1) !important
            }

        .luxury-outline-button {
            color: #f5d77a !important;
            border: 1px solid #d4af37;
            background: transparent
        }

            .luxury-outline-button:hover {
                background: #d4af37;
                color: #21170f !important
            }

        .luxury-gold-button {
            background: linear-gradient(135deg,#d4af37,#f0c85b) !important;
            color: #24180e !important;
            border: 1px solid #e0bd4f;
            box-shadow: 0 7px 20px rgba(180,135,20,.25);
            transition: .25s
        }

            .luxury-gold-button:hover {
                background: linear-gradient(135deg,#b99224,#e0b53f) !important;
                transform: translateY(-2px)
            }

        .luxury-transparent-button {
            background: rgba(20,15,10,.15);
            color: white;
            border: 1px solid rgba(255,255,255,.85);
            padding: 13px 22px;
            border-radius: 12px;
            font-weight: 800;
            transition: .25s
        }

            .luxury-transparent-button:hover {
                background: white;
                color: #21170f
            }

        .room-dropdown-menu {
            background: #29241e !important;
            border: 1px solid rgba(212,175,55,.35);
            box-shadow: 0 15px 40px rgba(0,0,0,.4) !important
        }

        .room-dropdown-item {
            background: #29241e !important;
            color: #f6f1e8 !important;
            border-bottom: 1px solid rgba(255,255,255,.1) !important
        }

            .room-dropdown-item:hover {
                background: #3b3329 !important;
                color: #f5d77a !important
            }

        .room-menu-divider {
            height: 3px;
            background: linear-gradient(90deg,transparent,#d4af37,transparent)
        }

        .hero-section {
            min-height: 790px;
            background-image: url('/images/luxury-hotel-hero.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden
        }

        .hero-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg,rgba(10,8,6,.58),rgba(20,13,8,.18) 45%,rgba(10,8,5,.62));
            z-index: 1
        }

        .hero-content {
            z-index: 2;
            padding-top: 70px
        }

        .hero-kicker, .section-kicker {
            color: #e5bd4e;
            font-size: .9rem;
            font-weight: 700;
            letter-spacing: 5px;
            text-transform: uppercase
        }

        .hero-title {
            font-family: Georgia,'Times New Roman',serif;
            font-size: clamp(2.7rem,6vw,5.5rem);
            line-height: 1.08;
            font-weight: 500;
            text-shadow: 0 5px 25px rgba(0,0,0,.65)
        }

            .hero-title span {
                color: #f2c65c;
                font-style: italic
            }

        .hero-description {
            font-size: clamp(1rem,2vw,1.25rem);
            line-height: 1.8;
            text-shadow: 0 2px 8px rgba(0,0,0,.55)
        }

        .hero-divider {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 16px;
            margin: 8px auto 25px;
            color: #e5bd4e
        }

            .hero-divider span {
                width: 70px;
                height: 1px;
                background: #d4af37
            }

        .hero-scroll {
            position: absolute;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 3;
            color: #e5bd4e;
            font-size: 22px;
            animation: luxuryBounce 1.6s infinite
        }

        @@keyframes luxuryBounce {
            0%, 100% {
                transform: translate(-50%,0)
            }

            50% {
                transform: translate(-50%,8px)
            }
        }

        .luxury-features-section {
            background: radial-gradient(circle at 0% 20%,rgba(212,175,55,.08),transparent 30%),radial-gradient(circle at 100% 80%,rgba(212,175,55,.07),transparent 30%),#f7f2e8
        }

        .luxury-section-title {
            font-family: Georgia,'Times New Roman',serif;
            font-size: clamp(2.3rem,4vw,3.6rem);
            color: #21180f;
            font-weight: 500;
            text-align: center
        }

        .luxury-section-description {
            color: #756b61;
            max-width: 720px;
            margin: 12px auto 0;
            line-height: 1.7
        }

        .luxury-feature-card {
            padding: 0 !important;
            overflow: hidden;
            border-radius: 20px !important;
            background: #2b2117 !important;
            border: 1px solid #d7c39a !important;
            box-shadow: 0 15px 35px rgba(45,31,15,.16) !important;
            color: #fff
        }

            .luxury-feature-card:hover {
                border-color: #d4af37 !important;
                box-shadow: 0 22px 50px rgba(80,53,15,.25) !important
            }

        .luxury-feature-image {
            height: 170px;
            background-size: cover;
            background-position: center;
            position: relative
        }

        .luxury-feature-image-1 {
            background-image: linear-gradient(rgba(30,18,8,.18),rgba(30,18,8,.35)),url('https://images.unsplash.com/photo-1566073771259-6a8506099945?q=80&w=900')
        }

        .luxury-feature-image-2 {
            background-image: linear-gradient(rgba(30,18,8,.18),rgba(30,18,8,.35)),url('https://images.unsplash.com/photo-1566665797739-1674de7a421a?q=80&w=900')
        }

        .luxury-feature-image-3 {
            background-image: linear-gradient(rgba(30,18,8,.18),rgba(30,18,8,.35)),url('https://images.unsplash.com/photo-1414235077428-338989a2e8c0?q=80&w=900')
        }

        .luxury-feature-icon {
            position: absolute;
            bottom: -25px;
            left: 50%;
            transform: translateX(-50%);
            width: 64px;
            height: 64px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #d4af37 !important;
            color: white !important;
            border: 4px solid rgba(255,255,255,.85);
            font-size: 24px;
            box-shadow: 0 8px 18px rgba(0,0,0,.25)
        }

        .luxury-feature-card .feature-content {
            padding: 48px 28px 28px
        }

        .luxury-feature-card h4 {
            color: #fff !important
        }

        .luxury-feature-card p {
            color: #e6ddd0 !important
        }

        .feature-link {
            color: #f0c85b !important;
            font-weight: 700
        }

        .luxury-page-banner {
            position: relative;
            padding: 120px 20px;
            background-size: cover;
            background-position: center;
            color: white;
            text-align: center
        }

        .luxury-page-banner-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg,rgba(20,13,8,.84),rgba(30,18,8,.58))
        }

        .luxury-back-button {
            background: #2b2117;
            color: #f5d77a;
            padding: 12px 20px;
            border-radius: 10px;
            font-weight: 700;
            border: 1px solid #c7a94b
        }

            .luxury-back-button:hover {
                background: #d4af37;
                color: #21170f
            }

        .luxury-room-card {
            border-radius: 18px !important;
            border: 1px solid #e2d5b8 !important;
            background: #fffdf8 !important;
            box-shadow: 0 12px 30px rgba(56,39,19,.09) !important;
            display: flex;
            flex-direction: column;
            height: 100%;
        }
            .luxury-room-card > .p-6 {
                display: flex;
                flex-direction: column;
                flex: 1;
            }
            .luxury-room-card h4 {
                line-height: 1.25;
                min-height: 60px;
                margin-bottom: 12px;
                letter-spacing: 0 !important;
                word-spacing: 0 !important;
                word-break: keep-all !important;
                overflow-wrap: normal !important;
                text-align: left !important;
                font-family: "Times New Roman", Georgia, serif !important;
            }
        .room-card-footer {
            margin-top: 24px;
        }

            .luxury-room-card:hover {
                border-color: #d4af37 !important;
                box-shadow: 0 22px 48px rgba(70,48,18,.18) !important
            }

        .luxury-room-tag {
            display: inline-block;
            background: #f3e3b0;
            color: #705315;
            padding: 6px 11px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1px
        }

        .luxury-room-price {
            color: #a97908 !important
        }

        .luxury-cta-section {
            background: linear-gradient(135deg,#1c130b,#382616);
            color: white;
            padding: 70px 20px;
            border-top: 2px solid #d4af37
        }

        .luxury-footer {
            background-image: linear-gradient(rgba(20,13,8,.92),rgba(20,13,8,.96)),url('/images/luxury-hotel-hero.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            border-top: 2px solid #d4af37
        }

        .footer-link {
            color: #d9d0c3;
            transition: .25s
        }

            .footer-link:hover {
                color: #f0c85b;
                padding-left: 4px
            }

        #page-booking {
            background: #f7f2e8
        }

            #page-booking > div:first-child {
                background: linear-gradient(135deg,#1d130a,#3b2817) !important;
                border-bottom: 2px solid #d4af37
            }

            #page-booking .bg-white {
                background: #fffdf8 !important;
                border-color: #e4d8bf !important
            }

            #page-booking .text-blue-700, #page-booking .text-blue-600 {
                color: #9b730e !important
            }

            #page-booking .bg-blue-600 {
                background: #b98b19 !important
            }

        .room-highlight {
            animation: roomHighlight 1.8s ease
        }

        @@keyframes roomHighlight {
            0%, 100% {
                box-shadow: 0 12px 30px rgba(56,39,19,.09)
            }

            35%, 65% {
                box-shadow: 0 0 0 5px rgba(212,175,55,.45),0 25px 55px rgba(70,48,18,.25)
            }
        }

        @@media(max-width:768px) {
            .hero-section {
                min-height: 720px;
                background-position: 62% center
            }

            .hero-content {
                padding-top: 95px
            }

            .luxury-feature-image {
                height: 180px
            }
        }

        /* ===== FIX TRIỆT ĐỂ LỖI CHỮ BỊ GIÃN / TÁCH KÝ TỰ ===== */
        .luxury-feature-card .feature-content,
        .luxury-footer {
            text-align: center !important;
            text-justify: none !important;
        }

            .luxury-feature-card h4,
            .luxury-footer h5 {
                display: inline-block !important;
                width: auto !important;
                max-width: 100% !important;
                margin-left: auto !important;
                margin-right: auto !important;
                text-align: center !important;
                text-align-last: auto !important;
                letter-spacing: 0 !important;
                word-spacing: 0 !important;
                word-break: normal !important;
                overflow-wrap: normal !important;
                white-space: nowrap !important;
                font-kerning: normal !important;
                font-variant-ligatures: normal !important;
            }

            .luxury-feature-card .feature-content p,
            .luxury-footer p,
            .luxury-footer a {
                letter-spacing: 0 !important;
                word-spacing: 0 !important;
                word-break: normal !important;
                overflow-wrap: normal !important;
                text-align: center !important;
                text-align-last: auto !important;
            }

            .luxury-footer .footer-link {
                display: inline-block !important;
                width: auto !important;
                text-align: left !important;
            }

        @@media (max-width: 768px) {
            .luxury-feature-card h4,
            .luxury-footer h5 {
                white-space: normal !important;
                display: block !important;
            }
        }

        /* =========================================================
