         ">

        <!-- TIÊU ĐỀ CHAT -->
        <div style="
            background: linear-gradient(135deg, #2563eb, #7c3aed);
            color: white;
            padding: 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        ">
