async function checkRoomAvailability() {

    // Lấy ID phòng đang chọn
    const roomId =
        parseInt(
            document.getElementById(
                'selectedRoomId'
            ).value
        );


    // Lấy ngày nhận phòng
    const checkIn =
        document.getElementById(
            'checkInDate'
        ).value;


    // Lấy ngày trả phòng
    const checkOut =
        document.getElementById(
            'checkOutDate'
        ).value;


    // Dòng dùng để hiển thị:
    // "Còn 5/5 phòng trống"
    const message =
        document.getElementById(
            'availabilityMessage'
        );


    // Ô chọn số phòng
    const roomCountSelect =
        document.getElementById(
            'roomCount'
        );


    // ===================================================
    // CHƯA ĐỦ THÔNG TIN THÌ CHƯA KIỂM TRA
    // ===================================================

    if (!roomId || !checkIn || !checkOut) {

        // Xóa thông báo cũ
        message.innerText = '';

        message.className =
            'mt-2 text-sm font-semibold text-gray-500';


        // Bật lại ô chọn số phòng
        roomCountSelect.disabled = false;


        // Tạo lại danh sách mặc định
        // để tránh còn chữ "Hết phòng"
        roomCountSelect.innerHTML = `
        <option value="1">1 phòng</option>
        <option value="2">2 phòng</option>
        <option value="3">3 phòng</option>
    `;


        // Mặc định chọn 1 phòng
        roomCountSelect.value = '1';


        return;
    }


    // ===================================================
    // KIỂM TRA NGÀY TRẢ
    // ===================================================

    if (checkOut <= checkIn) {

        message.innerText =
            'Ngày trả phòng phải sau ngày nhận phòng.';

        message.className =
            'mt-2 text-sm font-semibold text-red-600';


        // Bật lại ô số phòng
        roomCountSelect.disabled = false;


        // Khôi phục danh sách mặc định
        roomCountSelect.innerHTML = `
        <option value="1">1 phòng</option>
        <option value="2">2 phòng</option>
        <option value="3">3 phòng</option>
    `;

        roomCountSelect.value = '1';


        return;
    }


    try {

        // =================================================
        // TẠO ĐƯỜNG DẪN GỌI BookingController
        // =================================================

        const url =
            '@Url.Action("CheckAvailability", "Booking")'
            + '?roomId='
            + roomId
            + '&checkIn='
            + encodeURIComponent(checkIn)
            + '&checkOut='
            + encodeURIComponent(checkOut);


        // Gửi yêu cầu lên server
        const response =
            await fetch(url);


        // Nhận kết quả JSON
        const result =
            await response.json();


        // =================================================
        // SERVER BÁO LỖI
        // =================================================

        if (!result.success) {

            message.innerText =
                result.message ||
                'Không thể kiểm tra phòng trống.';

            message.className =
                'mt-2 text-sm font-semibold text-red-600';

            return;
        }


        // =================================================
        // LẤY SỐ PHÒNG CÒN LẠI
        // =================================================

        const availableRooms =
            Number(
                result.availableRooms || 0
            );


        const totalRooms =
            Number(
                result.totalRooms || 0
            );


        // =================================================
        // HẾT PHÒNG
        // =================================================

        if (availableRooms <= 0) {

            message.innerText =
                'Đã hết phòng trong khoảng thời gian này.';

            message.className =
                'mt-2 text-sm font-semibold text-red-600';


            roomCountSelect.innerHTML =
                '<option value="">Hết phòng</option>';


            roomCountSelect.disabled = true;

            return;
        }


        // =================================================
        // CÒN PHÒNG
        // =================================================

        message.innerText =
            'Còn '
            + availableRooms
            + '/'
            + totalRooms
            + ' phòng trống.';


        message.className =
            'mt-2 text-sm font-semibold text-green-600';


        // Cho phép chọn số phòng
        roomCountSelect.disabled = false;


        // Website hiện tại chỉ cho đặt tối đa 3 phòng
        const maxSelectable =
            Math.min(
                availableRooms,
                3
            );


        // Nhớ số phòng khách đang chọn
        const oldValue =
            parseInt(
                roomCountSelect.value
            ) || 1;


        // Xóa danh sách cũ
        roomCountSelect.innerHTML = '';


        // Tạo lại danh sách số phòng
        for (
            let i = 1;
            i <= maxSelectable;
            i++
        ) {

            const option =
                document.createElement(
                    'option'
                );


            option.value = i;

            option.textContent =
                i + ' phòng';


            roomCountSelect.appendChild(
                option
            );
        }


        // Nếu số phòng cũ vẫn hợp lệ
        // thì giữ nguyên
        if (oldValue <= maxSelectable) {

            roomCountSelect.value =
                oldValue;
        }
        else {

            // Nếu vượt quá số phòng còn lại
            // thì đưa về 1 phòng
            roomCountSelect.value = 1;
        }


        // Tính lại tiền
        updateBookingSummary();

    }
    catch (error) {

        console.error(error);


        message.innerText =
            'Không thể kiểm tra số phòng trống.';


        message.className =
            'mt-2 text-sm font-semibold text-red-600';
    }
}
