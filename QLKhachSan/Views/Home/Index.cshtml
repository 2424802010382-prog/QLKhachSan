    <script>

            /* =======================================================
               SHOW PAGE
            ======================================================= */

            function showPage(pageId) {

                const sections =
                    document.querySelectorAll('.page-section');

                sections.forEach(section => {

                    section.classList.remove('active');

                });

                const activePage =
                    document.getElementById('page-' + pageId);

                if (activePage) {

                    activePage.classList.add('active');

                    window.scrollTo(0, 0);

                }

        }
        // =======================================================
        // TỰ MỞ ĐÚNG TRANG KHI URL CÓ ?page=...
        // Ví dụ:
        // /Home/Index?page=rooms
        // =======================================================

        window.addEventListener(
            'load',
            function () {

                const params =
                    new URLSearchParams(
                        window.location.search
                    );

                const page =
                    params.get('page');


                if (page === 'rooms') {

                    showPage('rooms');

                }
                const loginRequired =
                    params.get(
                        'loginRequired'
                    );


                if (loginRequired === '1') {

                    openLoginModal();

                }
                const registerRequired =
                    params.get(
                        'registerRequired'
                    );
                const forgotRequired =
                    params.get(
                        'forgotRequired'
                    );


                if (forgotRequired === '1') {

                    openForgotPasswordModal();

                }



                if (registerRequired === '1') {

                    openRegisterModal();

                }
                // =======================================================
// ĐẶT LẠI PHÒNG TỪ LỊCH SỬ BOOKING
// =======================================================

const rebookRoomId =
    params.get(
        'rebookRoomId'
    );


if (rebookRoomId) {

    const roomCard =
        document.querySelector(
            '.room-card[data-room-id="' +
            rebookRoomId +
            '"]'
        );


    if (roomCard) {

        const roomId =
            parseInt(
                roomCard.getAttribute(
                    'data-room-id'
                )
            );


        const roomName =
            roomCard.getAttribute(
                'data-room-name'
            );


        const roomPrice =
            parseFloat(
                roomCard.getAttribute(
                    'data-room-price'
                )
            ) || 0;


        const roomCapacity =
            parseInt(
                roomCard.getAttribute(
                    'data-room-capacity'
                )
            ) || 1;


        // Mở thẳng form đặt phòng
        // Nếu bookRoom hiện có 3 tham số thì
        // tham số thứ 4 sẽ tự được JavaScript bỏ qua.
        bookRoom(
            roomId,
            roomName,
            roomPrice,
            roomCapacity
        );


        // Xóa rebookRoomId khỏi URL
        // để refresh trang không tự mở lại form.
        window.history.replaceState(
            {},
            document.title,
            '@Url.Action("Index", "Home")'
        );

    }

}

            }
        );
        // =======================================================
        // THIẾT LẬP NGÀY NHẬN - NGÀY TRẢ PHÒNG
        // =======================================================

        function formatDateForInput(date) {

            const year =
                date.getFullYear();

            const month =
                String(
                    date.getMonth() + 1
                ).padStart(2, '0');

            const day =
                String(
                    date.getDate()
                ).padStart(2, '0');


            return year
                + '-'
                + month
                + '-'
                + day;
        }


        // =======================================================
        // KHỞI TẠO NGÀY TỐI THIỂU
        // =======================================================

        function initializeBookingDates() {

            const checkInInput =
                document.getElementById(
                    'checkInDate'
                );

            const checkOutInput =
                document.getElementById(
                    'checkOutDate'
                );


            if (!checkInInput || !checkOutInput) {
                return;
            }


            // Hôm nay
            const today =
                new Date();

            today.setHours(
                0,
                0,
                0,
                0
            );


            // Ngày mai
            const tomorrow =
                new Date(today);

            tomorrow.setDate(
                tomorrow.getDate() + 1
            );


            // Ngày nhận sớm nhất = hôm nay
            checkInInput.min =
                formatDateForInput(today);


            // Ngày trả sớm nhất = ngày mai
            checkOutInput.min =
                formatDateForInput(tomorrow);
        }


        // =======================================================
        // KHI THAY ĐỔI NGÀY NHẬN PHÒNG
        // =======================================================

        function handleCheckInChange() {

            const checkInInput =
                document.getElementById(
                    'checkInDate'
                );

            const checkOutInput =
                document.getElementById(
                    'checkOutDate'
                );


            const checkIn =
                checkInInput.value;


            // Nếu chưa chọn ngày nhận
            if (!checkIn) {

                initializeBookingDates();

                updateBookingSummary();

                checkRoomAvailability();

                return;
            }


            // Chuyển ngày nhận thành Date
            const checkInDate =
                new Date(
                    checkIn + 'T00:00:00'
                );


            // Ngày trả tối thiểu
            // phải là ngày sau ngày nhận
            const minimumCheckOut =
                new Date(checkInDate);

            minimumCheckOut.setDate(
                minimumCheckOut.getDate() + 1
            );


            // Gán min cho ngày trả
            checkOutInput.min =
                formatDateForInput(
                    minimumCheckOut
                );


            // Nếu ngày trả đang nhỏ hơn
            // hoặc bằng ngày nhận
            // thì xóa ngày trả cũ
            if (
                checkOutInput.value &&
                checkOutInput.value <= checkIn
            ) {

                checkOutInput.value = '';

            }


            // Tính lại tiền
            updateBookingSummary();


            // Kiểm tra phòng trống
            checkRoomAvailability();
        }


        // =======================================================
        // KHI WEBSITE VỪA MỞ
        // =======================================================

        window.addEventListener(
            'load',
            function () {

                initializeBookingDates();

            }
        );

            /* =======================================================
               ĐĂNG NHẬP
            ======================================================= */

            function openLoginModal() {

                const modal =
                    document.getElementById('loginModal');

                const box =
                    modal.querySelector('.rounded-2xl');

