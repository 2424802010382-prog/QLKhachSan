    <script>
        // MỞ / ĐÓNG CHATBOT
        function toggleAIChat() {
            const chatBox = document.getElementById("aiChatBox");

            if (chatBox.style.display === "none" ||
                chatBox.style.display === "") {
                chatBox.style.display = "block";

                setTimeout(function () {
                    document.getElementById("aiMessageInput").focus();
                }, 100);
            } else {
                chatBox.style.display = "none";
            }
        }

        function quickAIMessage(message) {
            const input = document.getElementById("aiMessageInput");

            input.value = message;

            sendAIMessage();
        }
        // GỬI TIN NHẮN
        function sendAIMessage() {
            const input = document.getElementById("aiMessageInput");
            const message = input.value.trim();

            if (message === "") {
                return;
            }

            addAIMessage(message, "user");

            input.value = "";

            setTimeout(function () {
                const reply = getAIReply(message);
                addAIMessage(reply, "bot");
            }, 600);
        }

        // THÊM TIN NHẮN VÀO KHUNG CHAT
        function addAIMessage(message, sender) {
            const messages = document.getElementById("aiMessages");

            const messageRow = document.createElement("div");

            if (sender === "user") {
                messageRow.style.cssText = `
                                                    display: flex;
                                                    justify-content: flex-end;
                                                    margin-bottom: 15px;
                                                `;

                messageRow.innerHTML = `
                                                    <div style="
                                                        background: #2563eb;
                                                        color: white;
                                                        padding: 12px;
                                                        border-radius: 12px;
                                                        max-width: 80%;
                                                        font-size: 14px;
                                                        word-wrap: break-word;
                                                    ">
                                                        ${escapeAIText(message)}
                                                    </div>
                                                `;
            } else {
                messageRow.style.cssText = `
                                                    display: flex;
                                                    gap: 8px;
                                                    margin-bottom: 15px;
                                                `;

                messageRow.innerHTML = `
                                                    <div style="
                                                        width: 32px;
                                                        height: 32px;
                                                        min-width: 32px;
                                                        background: #dbeafe;
                                                        color: #2563eb;
                                                        border-radius: 50%;
                                                        display: flex;
                                                        align-items: center;
                                                        justify-content: center;
                                                    ">
                                                        <i class="fas fa-robot"></i>
                                                    </div>

                                                    <div style="
                                                        background: white;
                                                        color: #1f2937;
                                                        padding: 12px;
                                                        border-radius: 12px;
                                                        max-width: 80%;
                                                        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
                                                        font-size: 14px;
                                                        white-space: pre-line;
                                                    ">
                                                        ${escapeAIText(message)}
                                                    </div>
                                                `;
            }

            messages.appendChild(messageRow);
            messages.scrollTop = messages.scrollHeight;
        }

        // TRẢ LỜI MẪU CỦA CHATBOT
        function getAIReply(message) {
            const text = message.toLowerCase();

            if (text.includes("xin chào") ||
                text.includes("hello") ||
                text.includes("hi")) {

                return "Xin chào bạn! Tôi có thể giúp bạn tìm phòng, xem giá và đặt phòng tại Luxury Hotel.";
            }

            if (text.includes("giá phòng") ||
                text.includes("giá") ||
                text.includes("bao nhiêu tiền") ||
                text.includes("phòng bao nhiêu")) {

                return "Giá phòng hiện tại:\n\n" +
                    "• Standard: 800.000đ/đêm\n" +
                    "• Twin Room: 1.000.000đ/đêm\n" +
                    "• Superior: 1.200.000đ/đêm\n" +
                    "• Family Room: 1.500.000đ/đêm\n" +
                    "• Deluxe: 2.000.000đ/đêm\n" +
                    "• Premium: 2.500.000đ/đêm\n" +
                    "• Luxury Balcony Suite: 3.500.000đ/đêm\n" +
                    "• Phòng Tổng Thống: 8.000.000đ/đêm\n\n" +
                    "Bạn có thể nhập tên phòng để xem thêm thông tin.";
            }

            if (text.includes("deluxe")) {

                return "Phòng Deluxe có giá 2.000.000đ/đêm.\n\n" +
                    "Phòng phù hợp cho khách muốn có không gian nghỉ dưỡng và ngắm cảnh.\n\n" +
                    "Bạn hãy bấm nút 'Phòng' trên menu để đặt phòng.";
            }

            if (text.includes("superior")) {

                return "Phòng Superior có giá 1.200.000đ/đêm.\n\n" +
                    "Đây là lựa chọn phù hợp cho khách muốn tiết kiệm chi phí.\n\n" +
                    "Bạn hãy bấm nút 'Phòng' trên menu để đặt phòng.";
            }

            if (text.includes("luxury") ||
                text.includes("suite") ||
                text.includes("cao cấp")) {

                return "Phòng Luxury Balcony Suite có giá 3.500.000đ/đêm.\n\n" +
                    "Phòng có không gian cao cấp và ban công riêng.\n\n" +
                    "Bạn hãy bấm nút 'Phòng' trên menu để đặt phòng.";
            }

            if (text.includes("đặt phòng") ||
                text.includes("dat phong") ||
                text.includes("booking") ||
                text.includes("đặt")) {

                setTimeout(function () {
                    showPage("rooms");
                }, 800);

                return "Tôi đã mở trang danh sách phòng cho bạn. Hãy chọn phòng muốn đặt.";
            }

            if (text.includes("xem phòng") ||
                text.includes("xem danh sách phòng") ||
                text.includes("các phòng")) {

                setTimeout(function () {
                    showPage("rooms");
                }, 800);

                return "Đây là danh sách các phòng hiện có tại Luxury Hotel.";
            }

            if (text.includes("thanh toán") ||
                text.includes("thanh toan") ||
                text.includes("qr") ||
                text.includes("chuyển khoản")) {

                return "Khách sạn hỗ trợ thanh toán bằng tiền mặt và chuyển khoản. Bạn có thể chọn phương thức thanh toán khi đặt phòng.";
            }

            if (text.includes("nhận phòng") ||
                text.includes("nhan phong") ||
                text.includes("check-in")) {

                return "Bạn cần nhập ngày nhận phòng và ngày trả phòng trong biểu mẫu đặt phòng. Ngày trả phòng phải sau ngày nhận phòng.";
            }

            if (text.includes("hủy phòng") ||
                text.includes("huy phong")) {

                return "Nếu muốn hủy đặt phòng, bạn hãy liên hệ trực tiếp với bộ phận lễ tân để được hỗ trợ.";
            }

            if (text.includes("cảm ơn") ||
                text.includes("cam on")) {

                return "Rất vui được hỗ trợ bạn. Chúc bạn có một kỳ nghỉ tuyệt vời!";
            }

            return "Tôi chưa hiểu rõ câu hỏi của bạn.\n\n" +
                "Bạn có thể hỏi:\n" +
                "• Giá phòng bao nhiêu?\n" +
                "• Tôi muốn đặt phòng\n" +
                "• Có phòng Deluxe không?\n" +
                "• Thanh toán như thế nào?";
        }

        // BẢO VỆ NỘI DUNG HIỂN THỊ
        function escapeAIText(text) {
            return text
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>

    <script>

        // =======================================================
        // HỖ TRỢ 24/7
        // =======================================================

        function openSupport24Modal() {

            const modal =
                document.getElementById(
                    'support24Modal'
                );


            modal.classList.remove(
                'hidden'
            );


            modal.classList.add(
