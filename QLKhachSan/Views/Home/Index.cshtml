        <!-- ========================================================= -->

        <div id="page-booking" class="page-section">

            <!-- TIÊU ĐỀ -->
            <div class="bg-blue-900 text-white py-16 px-4 text-center">

                <div class="container mx-auto">

                    <h2 class="text-4xl font-extrabold mb-4">

                        Đặt Phòng Khách Sạn

                    </h2>

                    <p class="text-gray-200">

                        Vui lòng điền đầy đủ thông tin để hoàn tất đặt phòng.

                    </p>

                </div>

            </div>

            <!-- FORM ĐẶT PHÒNG -->

            <div class="container mx-auto py-12 px-4">

                <div class="max-w-4xl mx-auto">

                    <button onclick="showPage('rooms')"
                            class="mb-6 bg-gray-200 text-gray-700
                               px-5 py-3 rounded-lg
                               hover:bg-gray-300 transition">

                        <i class="fas fa-arrow-left mr-2"></i>

                        Quay lại chọn phòng

                    </button>

                    <div class="bg-white rounded-2xl shadow-xl
                            border border-gray-100 p-8">

                        <h3 class="text-2xl font-bold text-gray-800 mb-6">

                            <i class="fas fa-calendar-check text-blue-600 mr-2"></i>

                            Thông Tin Đặt Phòng

                        </h3>

                        <form id="bookingForm"
                              onsubmit="submitBooking(event)">

                            <!-- TÊN PHÒNG -->

                            <div class="mb-6">

                                <label class="block text-gray-700 font-semibold mb-2">

                                    Phòng đã chọn

                                </label>

                                <input type="text"
                                       id="selectedRoom"
                                       readonly
                                       class="w-full px-4 py-3
                                          border border-gray-300
                                          rounded-lg bg-gray-100
                                          text-gray-700">
                                <input type="hidden"
                                       id="selectedRoomId">

                            </div>

                            <!-- THÔNG TIN KHÁCH HÀNG -->

                            <h4 class="text-xl font-bold text-blue-700 mb-4">

                                Thông tin khách hàng

                            </h4>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                                <!-- HỌ TÊN -->

                                <div>

                                    <label class="block text-gray-700
                                              font-semibold mb-2">

                                        Họ và tên *

                                    </label>

                                    <input type="text"
                                           id="customerName"
                                           value="@(Session["FullName"] ?? "")"
                                           required
                                           placeholder="Nhập họ và tên"
                                           class="w-full px-4 py-3
                                              border border-gray-300
                                              rounded-lg
                                              focus:ring-2
                                              focus:ring-blue-500">

                                </div>

                                <!-- SỐ ĐIỆN THOẠI -->

                                <div>

                                    <label class="block text-gray-700
                                              font-semibold mb-2">

                                        Số điện thoại *

                                    </label>

                                    <input type="tel"
                                           id="customerPhone"
                                           required
                                           inputmode="numeric"
                                           minlength="10"
                                           maxlength="11"
                                           pattern="[0-9]{10,11}"
                                           title="Số điện thoại phải gồm 10 đến 11 chữ số"
                                           placeholder="Nhập số điện thoại"
                                           class="w-full px-4 py-3
              border border-gray-300
              rounded-lg
              focus:ring-2
              focus:ring-blue-500">

                                </div>

                                <!-- EMAIL -->

                                <div>

                                    <label class="block text-gray-700
                                              font-semibold mb-2">

                                        Email *

                                    </label>

                                    <input type="email"
                                           id="customerEmail"
                                           value="@(Session["Email"] ?? "")"
                                           required
                                           placeholder="example@gmail.com"
                                           class="w-full px-4 py-3
                                              border border-gray-300
                                              rounded-lg
                                              focus:ring-2
                                              focus:ring-blue-500">

                                </div>

                                <!-- CCCD -->

                                <div>

                                    <label class="block text-gray-700
                                              font-semibold mb-2">

                                        Số CCCD

                                    </label>

                                    <input type="text"
                                           id="customerCCCD"
                                           inputmode="numeric"
                                           maxlength="12"
                                           pattern="[0-9]{12}"
                                           title="CCCD phải gồm đúng 12 chữ số"
                                           placeholder="Nhập 12 số CCCD"
                                           class="w-full px-4 py-3
              border border-gray-300
              rounded-lg
              focus:ring-2
              focus:ring-blue-500">

                                </div>

                            </div>

                            <!-- THÔNG TIN NHẬN PHÒNG -->

                            <h4 class="text-xl font-bold text-blue-700
                                   mt-8 mb-4">

                                Thông tin nhận và trả phòng

                            </h4>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                                <!-- NGÀY NHẬN -->

                                <div>

                                    <label class="block text-gray-700
                                              font-semibold mb-2">

                                        Ngày nhận phòng *

                                    </label>

                                    <input type="date"
                                           id="checkInDate"
                                           onchange="handleCheckInChange();"
                                           required
                                           class="w-full px-4 py-3
              border border-gray-300
              rounded-lg">

                                </div>

                                <!-- NGÀY TRẢ -->

                                <div>

                                    <label class="block text-gray-700
                                              font-semibold mb-2">

                                        Ngày trả phòng *

                                    </label>

                                    <input type="date"
                                           id="checkOutDate"
                                           onchange="updateBookingSummary(); checkRoomAvailability();"
                                           required
                                           class="w-full px-4 py-3
              border border-gray-300
              rounded-lg">

                                </div>

                                <!-- SỐ NGƯỜI -->

                                <div>

                                    <label class="block text-gray-700
                                              font-semibold mb-2">

                                        Số người *

                                    </label>

                                    <select id="guestCount"
                                            onchange="validateGuestCapacity();"
                                            required
                                            class="w-full px-4 py-3
                                               border border-gray-300
                                               rounded-lg">

                                        <option value="">-- Chọn số người --</option>

                                        <option value="1">1 người</option>

                                        <option value="2">2 người</option>

                                        <option value="3">3 người</option>

                                        <option value="4">4 người</option>

                                        <option value="5">5 người</option>

                                        <option value="6">6 người</option>
                                        <option value="7">7 người</option>
                                        <option value="8">8 người</option>
                                        <option value="9">9 người</option>
                                        <option value="10">10 người</option>
                                        <option value="11">11 người</option>
                                        <option value="12">12 người</option>

                                    </select>
                                    <p id="capacityMessage"
                                       class="mt-2 text-sm font-semibold text-gray-500">
                                    </p>

                                </div>

                                <!-- SỐ PHÒNG -->

                                <div>

                                    <label class="block text-gray-700
                                              font-semibold mb-2">

                                        Số phòng *

                                    </label>

                                    <select id="roomCount"
                                            onchange="updateBookingSummary(); validateGuestCapacity();"
                                            required
                                            class="w-full px-4 py-3
               border border-gray-300
               rounded-lg">

                                        <option value="1">1 phòng</option>

                                        <option value="2">2 phòng</option>

                                        <option value="3">3 phòng</option>

                                    </select>
                                    <p id="availabilityMessage"
                                       class="mt-2 text-sm font-semibold text-gray-500">
                                    </p>

                                </div>

                            </div>

                            <!-- YÊU CẦU ĐẶC BIỆT -->

                            <div class="mt-6">

                                <label class="block text-gray-700
                                          font-semibold mb-2">

                                    Yêu cầu đặc biệt

                                </label>

                                <textarea id="specialRequest"
                                          rows="4"
                                          placeholder="Ví dụ: Phòng tầng cao, thêm giường..."
                                          class="w-full px-4 py-3
                                             border border-gray-300
                                             rounded-lg"></textarea>

                            </div>
                            <!-- ===================================================== -->
                            <!-- DỊCH VỤ BỔ SUNG -->
                            <!-- ===================================================== -->

                            <div class="mt-8">

                                <h4 class="text-xl font-bold text-blue-700 mb-4">

                                    <i class="fas fa-concierge-bell mr-2"></i>

                                    Dịch vụ bổ sung

                                </h4>

                                <p class="text-gray-500 text-sm mb-4">
                                    Bạn có thể chọn thêm các dịch vụ trong thời gian lưu trú.
                                </p>

                                <div id="serviceList"
                                     class="grid grid-cols-1 md:grid-cols-2 gap-4">

                                    <div class="text-gray-500">
                                        Đang tải dịch vụ...
                                    </div>

                                </div>

                            </div>


                            <!-- ===================================================== -->
                            <!-- MÃ KHUYẾN MÃI -->
                            <!-- ===================================================== -->

                            <div class="mt-8">

                                <h4 class="text-xl font-bold text-blue-700 mb-4">

                                    <i class="fas fa-tags mr-2"></i>

                                    Mã khuyến mãi

                                </h4>

                                <div class="flex flex-col md:flex-row gap-3">

                                    <input type="text"
                                           id="promotionCode"
                                           oninput="resetPromotion()"
                                           placeholder="Ví dụ: WELCOME10"
                                           class="flex-1 px-4 py-3
                          border border-gray-300
                          rounded-lg
                          uppercase">

                                    <button type="button"
                                            onclick="checkPromotion()"
                                            class="bg-yellow-500
                           hover:bg-yellow-600
                           text-gray-900
                           font-bold
                           px-6 py-3
                           rounded-lg">

                                        <i class="fas fa-check mr-2"></i>

                                        Áp dụng

                                    </button>

                                </div>

                                <p id="promotionMessage"
                                   class="mt-2 text-sm font-semibold">
                                </p>

                            </div>
                            <!-- ===================================================== -->
                            <!-- TẠM TÍNH CHI PHÍ -->
                            <!-- ===================================================== -->

                            <div class="mt-8 bg-yellow-50
                            border border-yellow-200
                            rounded-xl p-5">

                                <h4 class="text-xl font-bold text-gray-800 mb-4">
                                    <i class="fas fa-receipt text-yellow-600 mr-2"></i>
                                    Tạm tính chi phí
                                </h4>

                                <div class="space-y-3">

                                    <div class="flex justify-between">
                                        <span>Tiền phòng</span>
                                        <span id="roomSubtotal"
                                              class="font-semibold">
                                            0đ
                                        </span>
                                    </div>

                                    <div class="flex justify-between">
                                        <span>Dịch vụ</span>
                                        <span id="serviceSubtotal"
                                              class="font-semibold">
                                            0đ
                                        </span>
                                    </div>

                                    <div class="flex justify-between text-green-700">
                                        <span>Khuyến mãi</span>
                                        <span id="discountAmount"
                                              class="font-semibold">
                                            -0đ
                                        </span>
                                    </div>

                                    <hr>

                                    <div class="flex justify-between
                    text-xl font-bold">

                                        <span>Tổng thanh toán</span>

                                        <span id="bookingTotal"
                                              class="text-red-600">
                                            0đ
                                        </span>

                                    </div>

                                </div>

                            </div>
                            <!-- PHƯƠNG THỨC THANH TOÁN -->

                            <div class="mt-6">

                                <label class="block text-gray-700 font-semibold mb-2">

                                    Phương thức thanh toán

                                </label>

                                <select id="paymentMethod"
                                        onchange="togglePaymentMethod()"
                                        class="w-full px-4 py-3
                       border border-gray-300
                       rounded-lg">

                                    <option value="Thanh toán tại khách sạn">

                                        Thanh toán tại khách sạn

                                    </option>

                                    <option value="Chuyển khoản">

                                        Chuyển khoản ngân hàng

                                    </option>

                                </select>

                            </div>

                            <!-- ===================================================== -->
                            <!-- KHU VỰC THANH TOÁN QR -->
                            <!-- ===================================================== -->

                            <div id="qrPaymentSection"
                                 class="hidden mt-6 bg-blue-50
                border-2 border-blue-200
                rounded-2xl p-6">

                                <h4 class="text-2xl font-bold text-blue-800 text-center mb-4">

                                    <i class="fas fa-qrcode mr-2"></i>

                                    Thanh toán chuyển khoản

                                </h4>

                                <!-- ĐẾM NGƯỢC -->

                                <div class="text-center mb-5">

                                    <p class="text-gray-600 font-semibold">

                                        Thời gian giữ lệnh thanh toán

                                    </p>

                                    <div id="countdownTimer"
                                         class="text-5xl font-extrabold
                        text-red-600 mt-2">

                                        10:00

                                    </div>

                                    <p class="text-sm text-gray-500 mt-2">

                                        Vui lòng chuyển khoản trước khi hết thời gian.

                                    </p>

                                </div>

                                <!-- MÃ QR -->

                                <div class="bg-white rounded-xl p-4
                    text-center shadow-md mb-5">

                                    <img id="qrImage"
                                         src=""
                                         alt="Mã QR chuyển khoản ngân hàng"
                                         class="mx-auto w-64 h-64 object-contain">

                                    <p class="text-gray-500 text-sm mt-2">

                                        Mở ứng dụng ngân hàng và quét mã QR.

                                    </p>

                                </div>

                                <!-- THÔNG TIN NGÂN HÀNG -->

                                <div class="bg-white rounded-xl p-5
                    space-y-3 shadow-sm">

                                    <h5 class="font-bold text-lg text-gray-800">

                                        Thông tin chuyển khoản

                                    </h5>

                                    <div class="flex justify-between gap-3">

                                        <span class="text-gray-500">

                                            Ngân hàng

                                        </span>

                                        <span class="font-bold">

                                            Vietcombank

                                        </span>

                                    </div>

                                    <div class="flex justify-between gap-3">

                                        <span class="text-gray-500">

                                            Số tài khoản

                                        </span>

                                        <span class="font-bold">

                                            1038619653

                                        </span>

                                    </div>

                                    <div class="flex justify-between gap-3">

                                        <span class="text-gray-500">

                                            Chủ tài khoản

                                        </span>

                                        <span class="font-bold">

                                            LUXURY HOTEL

                                        </span>

                                    </div>

                                    <div class="flex justify-between gap-3">

                                        <span class="text-gray-500">

                                            Số tiền

                                        </span>

                                        <span id="qrAmount"
                                              class="font-bold text-blue-700">

                                            0đ

                                        </span>

                                    </div>

                                    <div class="flex justify-between gap-3">

                                        <span class="text-gray-500">

                                            Nội dung

                                        </span>

                                        <span id="qrContent"
                                              class="font-bold text-blue-700">

                                            LUXURYHOTEL

                                        </span>

                                    </div>

                                </div>

                                <!-- TRẠNG THÁI -->

                                <div id="paymentStatus"
                                     class="mt-5 text-center
                    text-sm text-gray-600">

                                    Đang chờ thanh toán...

                                </div>

                                <!-- NÚT ĐÃ CHUYỂN KHOẢN -->

                                <button type="button"
                                        id="paymentDoneButton"
                                        onclick="confirmPayment()"
                                        class="w-full mt-5 bg-green-600
                       text-white font-bold
                       py-4 rounded-xl
                       hover:bg-green-700 transition">

                                    <i class="fas fa-check-circle mr-2"></i>

                                    Tôi đã chuyển khoản

                                </button>

                            </div>

                            <!-- NÚT XÁC NHẬN -->

                            <div class="mt-8 flex flex-col md:flex-row gap-4">

                                <button type="submit"
                                        id="submitBookingButton"
                                        class="flex-1 bg-blue-600 text-white
               font-bold px-6 py-4 rounded-xl
               hover:bg-blue-700 transition
               disabled:opacity-60
               disabled:cursor-not-allowed">

                                    <i id="submitBookingIcon"
                                       class="fas fa-check-circle mr-2"></i>

                                    <span id="submitBookingText">
                                        Xác nhận đặt phòng
                                    </span>

                                </button>

                                <button type="button"
                                        onclick="showPage('rooms')"
                                        class="bg-gray-200 text-gray-700
                                           font-bold px-6 py-4 rounded-xl
                                           hover:bg-gray-300 transition">

                                    Hủy

                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>
    </main>

    <!-- FOOTER -->
    <footer class="luxury-footer text-gray-200 py-12 px-4 mt-auto">
        <div class="container mx-auto grid grid-cols-1 md:grid-cols-4 gap-10">
            <div class="col-span-1 md:col-span-2">
                <div class="flex items-center gap-3 mb-5"><div class="luxury-crown-logo small"><i class="fas fa-crown"></i></div><div><h1 class="text-2xl font-serif font-bold text-white">LUXURY HOTEL</h1><p class="text-yellow-300 text-xs tracking-[3px]">LUXURY &amp; COMFORT</p></div></div>
                <p class="text-sm leading-7 max-w-xl text-gray-300">Mang lại trải nghiệm kỳ nghỉ đẳng cấp quốc tế với dịch vụ 5 sao hoàn hảo. Sự hài lòng của quý khách là ưu tiên hàng đầu của chúng tôi.</p>
            </div>
            <div><h5 class="font-serif font-bold text-white text-xl mb-4">Liên kết</h5><ul class="space-y-3 text-sm"><li><a href="#" onclick="showPage('home'); return false;" class="footer-link">Trang chủ</a></li><li><a href="#" onclick="showPage('rooms'); return false;" class="footer-link">Phòng</a></li><li><a href="#" onclick="showPage('rooms'); return false;" class="footer-link">Đặt phòng</a></li><li><a href="#" class="footer-link">Dịch vụ</a></li></ul></div>
            <div><h5 class="font-serif font-bold text-white text-xl mb-4">Liên hệ</h5><p class="text-sm mb-3"><i class="fas fa-map-marker-alt mr-2 text-yellow-400"></i>123 Đường ABC, Quận 1, TP.HCM</p><p class="text-sm mb-3"><i class="fas fa-phone-alt mr-2 text-yellow-400"></i>Hotline: 1900 1234</p><p class="text-sm"><i class="fas fa-envelope mr-2 text-yellow-400"></i>info@luxuryhotel.com</p></div>
        </div>
        <div class="container mx-auto border-t border-yellow-500/30 mt-10 pt-6 text-center text-xs text-gray-500">&copy; 2026 Luxury Hotel. All rights reserved.</div>
    </footer>

    <!-- ========================================================= -->
    <!-- MODAL ĐĂNG NHẬP -->
    <!-- ========================================================= -->

    <div id="loginModal"
         class="fixed inset-0 bg-black/70 hidden
                    justify-center items-center p-4 z-50
                    transition-opacity duration-300 opacity-0">

        <div class="bg-white rounded-2xl max-w-sm w-full p-10
                        shadow-2xl relative
                        transform scale-90 transition-transform duration-300">

            <!-- Đóng -->
            <button type="button"
                    onclick="closeLoginModal()"
                    class="absolute top-4 right-4
                               text-gray-400 hover:text-gray-600">

                <i class="fas fa-times text-xl"></i>

            </button>

            <!-- Icon -->
            <div class="text-center mb-8">

                <i class="fas fa-user-circle text-6xl
                              text-blue-600 mb-4 drop-shadow">
                </i>

                <h2 class="text-3xl font-bold text-blue-700">
                    ĐĂNG NHẬP
                </h2>

                <p class="text-gray-500 text-sm mt-1">
                    Chào mừng bạn trở lại!
                </p>

            </div>
            @if (TempData["LoginError"] != null)
            {
                <div class="mb-5
                rounded-lg
                border border-red-200
                bg-red-50
                px-4 py-3
                text-sm
                text-red-700">

                    <i class="fas fa-circle-exclamation mr-2"></i>

                    @TempData["LoginError"]

                </div>
            }


            @if (TempData["RegisterSuccess"] != null)
            {
                <div class="mb-5
                rounded-lg
                border border-green-200
                bg-green-50
                px-4 py-3
                text-sm
                text-green-700">

                    <i class="fas fa-circle-check mr-2"></i>

                    @TempData["RegisterSuccess"]

                </div>
            }
            @if (TempData["LoginSuccess"] != null)
            {
                <div class="mb-5
                rounded-lg
                border
                border-green-200
                bg-green-50
                px-4
                py-3
                text-sm
                text-green-700
                font-semibold">

                    <i class="fas
                  fa-circle-check
                  mr-2">
                    </i>

                    @TempData["LoginSuccess"]

                </div>
            }
            <form action="@Url.Action("Login", "Account")"
                  method="post">

                @Html.AntiForgeryToken()
                <!-- Email -->
                <div class="mb-5">

                    <label class="block text-sm font-semibold mb-1 text-gray-700">

                        Tên đăng nhập

                    </label>

                    <div class="relative">

                        <i class="fas fa-envelope absolute left-3
                                      top-1/2 -translate-y-1/2 text-gray-400">
                        </i>

                        <input type="text"
                               id="loginUsername"
                               name="username"
                               required
                               autocomplete="username"
                               class="w-full border border-gray-300
              rounded-lg pl-10 pr-3 py-3 text-sm
              focus:ring-2 focus:ring-blue-500
              focus:outline-none transition"
                               placeholder="Nhập tên đăng nhập">

                    </div>

                </div>

                <!-- Mật khẩu -->
                <div class="mb-3">

                    <label class="block text-sm font-semibold mb-1 text-gray-700">

                        Mật khẩu

                    </label>

                    <div class="relative">

                        <i class="fas fa-lock absolute left-3
                                      top-1/2 -translate-y-1/2 text-gray-400">
                        </i>

                        <input type="password"
                               id="loginPassword"
                               name="password"
                               required
                               autocomplete="current-password"
                               class="w-full border border-gray-300
              rounded-lg pl-10 pr-3 py-3 text-sm
              focus:ring-2 focus:ring-blue-500
              focus:outline-none transition"
                               placeholder="Nhập mật khẩu">

                    </div>

                </div>

                <!-- QUÊN MẬT KHẨU -->
                <div class="flex justify-end mb-6">

                    <a href="#"
                       onclick="switchToForgotPassword(); return false;"
                       class="text-sm text-blue-600 hover:underline">

                        Quên mật khẩu?

                    </a>

                </div>

                <!-- Đăng nhập -->
                <button type="submit"
                        class="w-full bg-blue-600 text-white
                                   font-bold py-3 rounded-lg
                                   hover:bg-blue-700 transition
                                   shadow-lg">

                    ĐĂNG NHẬP

                </button>

            </form>

            <!-- Đăng ký -->
            <div class="text-center mt-8 text-sm border-t pt-5">

                <p class="text-gray-600">

                    Chưa có tài khoản?

                    <a href="#"
                       onclick="closeLoginModal(); openRegisterModal(); return false;"
                       class="text-blue-600 font-semibold hover:underline">

                        Đăng ký ngay

                    </a>

                </p>

            </div>

        </div>

    </div>

